; Inno Setup script for the Rotula installer.
; Built locally by packaging\installer\build-installer.cmd (which also signs the program and the installer):
;   ISCC.exe /DAppVersion=0.1.0 /DSourceDir=<staged files> /DOutputDir=<out> packaging\installer\Rotula.iss
; The installer is per-user (no administrator rights). See docs/releasing.md.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef SourceDir
  #define SourceDir "..\..\artifacts\stage"
#endif
#ifndef OutputDir
  #define OutputDir "..\..\artifacts"
#endif

; VersionInfoVersion must be numeric (major.minor.patch). A prerelease such as 0.2.0-rc1 keeps its full text in
; AppVersion and the file name, but only 0.2.0 goes into the version resource.
#ifndef AppVersionNumeric
  #if Pos("-", AppVersion) > 0
    #define AppVersionNumeric Copy(AppVersion, 1, Pos("-", AppVersion) - 1)
  #else
    #define AppVersionNumeric AppVersion
  #endif
#endif

[Setup]
; AppId must never change: it is how Windows and winget recognise upgrades of the same product.
AppId={{6B0E5C1A-3F7D-4C52-9A1E-2D8F4B7A9C31}
AppName=Rotula
AppVersion={#AppVersion}
AppVerName=Rotula {#AppVersion}
AppPublisher=P4 Software
AppPublisherURL=https://github.com/P4Software/Rotula
AppSupportURL=https://github.com/P4Software/Rotula/issues
AppUpdatesURL=https://github.com/P4Software/Rotula/releases
DefaultDirName={autopf}\Rotula
DefaultGroupName=Rotula
DisableProgramGroupPage=yes
; Per-user install: no UAC prompt, and winget can install it silently without elevation.
PrivilegesRequired=lowest
; /ALLUSERS (all users, Program Files, needs administrator rights) and /CURRENTUSER work on the command line for silent deployment (docs/deployment.md).
PrivilegesRequiredOverridesAllowed=commandline dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; The page the user must accept: Rotula's MIT licence plus the full terms of every non-permissive component that ships
; (generated at build time by build-installer.ps1; see docs/releasing.md).
LicenseFile={#SourceDir}\LICENSE-THIRD-PARTY.txt
OutputDir={#OutputDir}
OutputBaseFilename=Rotula-{#AppVersion}-win-x64-setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
; Brand artwork (generated by tools\brand). Inno Setup picks the image closest to the screen scale, so the 100 / 125 / 150 / 200 / 250 percent variants are listed.
SetupIconFile=..\..\src\Rotula.App\Assets\rotula.ico
WizardImageFile=assets\wizard-164x314.bmp,assets\wizard-192x386.bmp,assets\wizard-246x459.bmp,assets\wizard-328x604.bmp,assets\wizard-410x797.bmp
WizardSmallImageFile=assets\wizard-small-55x55.bmp,assets\wizard-small-64x68.bmp,assets\wizard-small-83x80.bmp,assets\wizard-small-110x106.bmp,assets\wizard-small-138x140.bmp
; Tells Explorer to refresh file associations after install/uninstall (needed for the .rotula association below).
ChangesAssociations=yes
UninstallDisplayIcon={app}\Rotula.App.exe
UninstallDisplayName=Rotula
VersionInfoVersion={#AppVersionNumeric}
VersionInfoProductVersion={#AppVersionNumeric}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
; The same four languages as the application (Loc.SupportedLanguages). Both files ship with Inno Setup itself.
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
; Checked by default: double-clicking a .rotula file should open it in Rotula. Users can untick it.
Name: "associate"; Description: "Open .rotula label files with Rotula"; GroupDescription: "File associations:"

[Files]
Source: "{#SourceDir}\Rotula.App.exe"; DestDir: "{app}"; Flags: ignoreversion
; The MCP server: a console program for AI clients, started by them, so it gets no Start menu entry. docs\mcp.md says how to connect it.
Source: "{#SourceDir}\Rotula.Mcp.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\LICENSE-THIRD-PARTY.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\docs\mcp.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "{#SourceDir}\packs\README.txt"; DestDir: "{app}\packs"; Flags: ignoreversion
Source: "{#SourceDir}\THIRD-PARTY-NOTICES.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\README.md"; DestDir: "{app}"; Flags: ignoreversion
; The icon of .rotula documents in Explorer. The registry entry below points at this file, so it must exist on disk (not only inside the exe).
Source: "{#SourceDir}\Assets\rotula-document.ico"; DestDir: "{app}\Assets"; Flags: ignoreversion

[Dirs]
; Add-ons placed in "packs" beside the exe are trusted by Rotula (see docs/data-providers.md). The folder starts empty.
Name: "{app}\packs"

[UninstallDelete]
; Created by Rotula.Mcp.exe on first run, next to the exe. Removing it lets the install folder disappear on uninstall.
Type: files; Name: "{app}\rotula-mcp.settings.json"

[Registry]
; HKA writes to HKCU for a per-user install and to HKLM for an all-users install, so no admin rights are
; needed by default. The file name is passed as the first argument, which the app already opens (App.OnStartup).
Root: HKA; Subkey: "Software\Classes\.rotula"; ValueType: string; ValueName: ""; ValueData: "Rotula.Label"; Flags: uninsdeletevalue uninsdeletekeyifempty; Tasks: associate
Root: HKA; Subkey: "Software\Classes\Rotula.Label"; ValueType: string; ValueName: ""; ValueData: "Rotula label"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\Rotula.Label\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\Assets\rotula-document.ico"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\Rotula.Label\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\Rotula.App.exe"" ""%1"""; Tasks: associate

[Icons]
Name: "{autoprograms}\Rotula"; Filename: "{app}\Rotula.App.exe"
Name: "{autodesktop}\Rotula"; Filename: "{app}\Rotula.App.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Rotula.App.exe"; Description: "{cm:LaunchProgram,Rotula}"; Flags: nowait postinstall skipifsilent
