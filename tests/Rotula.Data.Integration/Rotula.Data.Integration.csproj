<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Tests that need a real server are skipped (never failed) when none is running; see ServerCatalog. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- No coverlet.collector on purpose: the build workflow takes the FIRST cobertura report it finds for the Rotula.Core
         coverage gate, and a second project that loads Rotula.Core with almost no coverage must not be picked. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql and MySqlConnector arrive through Rotula.Data (same versions as the product). -->
    <ProjectReference Include="..\..\src\Rotula.Data\Rotula.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PowerShell scripts, the settings file and the certificate generator are not part of the test assembly. -->
    <Compile Remove="servers\**" />
    <None Include="servers\**" />
  </ItemGroup>

</Project>
