<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows so the tests can reference the WPF application (Rotula.App); everything else still runs unchanged. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rotula.Core\Rotula.Core.csproj" />
    <ProjectReference Include="..\..\src\Rotula.Data\Rotula.Data.csproj" />
    <ProjectReference Include="..\..\src\Rotula.Rendering\Rotula.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Rotula.Printing\Rotula.Printing.csproj" />
    <ProjectReference Include="..\..\src\Rotula.Files\Rotula.Files.csproj" />
    <ProjectReference Include="..\..\src\Rotula.Mcp\Rotula.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Rotula.App\Rotula.App.csproj" />
    <!-- The sample provider pack: built before the tests, never referenced (a reference would make the default load context
         resolve it and the isolation tests would prove nothing). Its output is copied to testpacks/sample below. -->
    <ProjectReference Include="..\Rotula.Data.SamplePack\Rotula.Data.SamplePack.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopySamplePack" AfterTargets="Build">
    <ItemGroup>
      <SamplePackFiles Include="..\Rotula.Data.SamplePack\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePackFiles)" DestinationFiles="@(SamplePackFiles->'$(OutDir)testpacks\sample\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>