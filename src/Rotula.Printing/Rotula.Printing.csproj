<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rotula.Core\Rotula.Core.csproj" />
    <!-- Picture-mode printing draws the label with the Skia renderer. Rendering references only Core (never Printing), so there is no cycle. -->
    <ProjectReference Include="..\Rotula.Rendering\Rotula.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise the Win32 error mapping without making it public API. -->
    <InternalsVisibleTo Include="Rotula.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
