<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ClickHouse provider pack (packs/clickhouse), over ClickHouse's HTTP(S) interface. Shared pack settings and the reason for the
    odd-looking references to the host assemblies are in ..\PackProject.props.
    Driver: ClickHouse.Driver 1.5.0 (MIT), the maintained successor of ClickHouse.Client, published by ClickHouse itself; it has a net10.0
    build, so no older framework is needed.
  -->
  <Import Project="..\PackProject.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rotula.Data.Pack.ClickHouse</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rotula.Data.Packs.Tests" />
  </ItemGroup>

</Project>
