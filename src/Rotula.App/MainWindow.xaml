<Window x:Class="Rotula.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:ed="clr-namespace:Rotula.App.Editing"
        xmlns:model="clr-namespace:Rotula.Core.Model;assembly=Rotula.Core"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        AutomationProperties.Name="Rotula">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
    <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}" />
    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}" />
    <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RotateClockwiseCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RotateCounterClockwiseCommand}" />
    <KeyBinding Key="F3" Command="{Binding SelectNextCommand}" />
    <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding SelectPreviousCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomActualSizeCommand}" />
    <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding ZoomFitCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- ================================ menu ================================ -->
    <Menu DockPanel.Dock="Top" AutomationProperties.Name="{loc:T Menu.Main}">
      <MenuItem Header="{loc:T Menu.File}">
        <MenuItem Header="{loc:T Menu.New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Header="{loc:T Menu.Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Header="{loc:T Menu.Recent}" ItemsSource="{Binding RecentFiles}">
          <MenuItem.Style>
            <Style TargetType="MenuItem">
              <Style.Triggers>
                <Trigger Property="HasItems" Value="False"><Setter Property="IsEnabled" Value="False" /></Trigger>
              </Style.Triggers>
            </Style>
          </MenuItem.Style>
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding Display}" />
              <Setter Property="ToolTip" Value="{Binding Path}" />
              <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:T Menu.Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="{loc:T Menu.SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Export}">
          <MenuItem Header="{loc:T Menu.ExportPng}" Command="{Binding ExportPngCommand}" />
          <MenuItem Header="{loc:T Menu.ExportPdf}" Command="{Binding ExportPdfCommand}" />
          <MenuItem Header="{loc:T Menu.ExportZpl}" Command="{Binding ExportZplCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.ImportZpl}" Command="{Binding ImportZplCommand}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Print}" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Exit}" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Edit}">
        <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Cut}" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
        <MenuItem Header="{loc:T Menu.Copy}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
        <MenuItem Header="{loc:T Menu.Paste}" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
        <MenuItem Header="{loc:T Menu.Duplicate}" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
        <MenuItem Header="{loc:T Menu.Delete}" Command="{Binding DeleteCommand}" InputGestureText="Del" />
        <Separator />
        <MenuItem Header="{loc:T Menu.SelectAll}" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
        <MenuItem Header="{loc:T Menu.SelectNext}" Command="{Binding SelectNextCommand}" InputGestureText="F3" />
        <MenuItem Header="{loc:T Menu.SelectPrevious}" Command="{Binding SelectPreviousCommand}" InputGestureText="Shift+F3" />
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Arrange}">
        <MenuItem Header="{loc:T Menu.BringToFront}" Command="{Binding BringToFrontCommand}" />
        <MenuItem Header="{loc:T Menu.BringForward}" Command="{Binding BringForwardCommand}" />
        <MenuItem Header="{loc:T Menu.SendBackward}" Command="{Binding SendBackwardCommand}" />
        <MenuItem Header="{loc:T Menu.SendToBack}" Command="{Binding SendToBackCommand}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.RotateCw}" Command="{Binding RotateClockwiseCommand}" InputGestureText="Ctrl+R" />
        <MenuItem Header="{loc:T Menu.RotateCcw}" Command="{Binding RotateCounterClockwiseCommand}" InputGestureText="Ctrl+Shift+R" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Align}">
          <MenuItem Header="{loc:T Menu.AlignLeft}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Left}" />
          <MenuItem Header="{loc:T Menu.AlignCenterH}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.CenterHorizontal}" />
          <MenuItem Header="{loc:T Menu.AlignRight}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Right}" />
          <MenuItem Header="{loc:T Menu.AlignTop}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Top}" />
          <MenuItem Header="{loc:T Menu.AlignCenterV}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.CenterVertical}" />
          <MenuItem Header="{loc:T Menu.AlignBottom}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Bottom}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.Distribute}">
          <MenuItem Header="{loc:T Menu.DistributeH}" Command="{Binding DistributeCommand}" CommandParameter="{x:Static ed:DistributeKind.Horizontal}" />
          <MenuItem Header="{loc:T Menu.DistributeV}" Command="{Binding DistributeCommand}" CommandParameter="{x:Static ed:DistributeKind.Vertical}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="{loc:T Menu.View}">
        <MenuItem Header="{loc:T Menu.ZoomIn}" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
        <MenuItem Header="{loc:T Menu.ZoomOut}" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
        <MenuItem Header="{loc:T Menu.ZoomActual}" Command="{Binding ZoomActualSizeCommand}" InputGestureText="Ctrl+0" />
        <MenuItem Header="{loc:T Menu.ZoomFit}" Command="{Binding ZoomFitCommand}" InputGestureText="Ctrl+9" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Units}">
          <MenuItem Header="{loc:T Menu.UnitMm}" Command="{Binding SetUnitCommand}" CommandParameter="{x:Static model:LengthUnit.Millimeters}" IsChecked="{Binding IsUnitMm, Mode=OneWay}" />
          <MenuItem Header="{loc:T Menu.UnitInch}" Command="{Binding SetUnitCommand}" CommandParameter="{x:Static model:LengthUnit.Inches}" IsChecked="{Binding IsUnitInch, Mode=OneWay}" />
          <MenuItem Header="{loc:T Menu.UnitDots}" Command="{Binding SetUnitCommand}" CommandParameter="{x:Static model:LengthUnit.Dots}" IsChecked="{Binding IsUnitDots, Mode=OneWay}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.Grid}" IsCheckable="True" IsChecked="{Binding GridVisible, Mode=TwoWay}" />
        <MenuItem Header="{loc:T Menu.SnapGrid}" IsCheckable="True" IsChecked="{Binding SnapToGrid, Mode=TwoWay}" />
        <MenuItem Header="{loc:T Menu.SnapGuides}" IsCheckable="True" IsChecked="{Binding SnapToGuides, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Language}">
          <MenuItem Header="{loc:T Menu.LanguageAuto}" Command="{Binding SetLanguageCommand}" CommandParameter="auto" IsChecked="{Binding IsLanguageAuto, Mode=OneWay}" />
          <MenuItem Header="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" IsChecked="{Binding IsLanguageEn, Mode=OneWay}" />
          <MenuItem Header="Espa&#241;ol" Command="{Binding SetLanguageCommand}" CommandParameter="es" IsChecked="{Binding IsLanguageEs, Mode=OneWay}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Help}">
        <MenuItem Header="{loc:T Menu.About}" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- ================================ toolbar ================================ -->
    <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource WindowBrush}">
      <ToolBar AutomationProperties.Name="{loc:T Toolbar.Main}">
        <Button Content="{loc:T Menu.New}" Command="{Binding NewCommand}" ToolTip="{loc:T Menu.New}" AutomationProperties.Name="{loc:T Menu.New}" />
        <Button Content="{loc:T Menu.Open}" Command="{Binding OpenCommand}" ToolTip="{loc:T Menu.Open}" AutomationProperties.Name="{loc:T Menu.Open}" />
        <Button Content="{loc:T Menu.Save}" Command="{Binding SaveCommand}" ToolTip="{loc:T Menu.Save}" AutomationProperties.Name="{loc:T Menu.Save}" />
        <Button Content="{loc:T Menu.Print}" Command="{Binding PrintCommand}" ToolTip="{loc:T Menu.Print}" AutomationProperties.Name="{loc:T Menu.Print}" />
      </ToolBar>
      <ToolBar AutomationProperties.Name="{loc:T Toolbar.Edit}">
        <Button Content="{loc:T Menu.Undo}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoText}" AutomationProperties.Name="{loc:T Menu.Undo}" />
        <Button Content="{loc:T Menu.Redo}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoText}" AutomationProperties.Name="{loc:T Menu.Redo}" />
        <Separator />
        <Button Content="{loc:T Menu.Duplicate}" Command="{Binding DuplicateCommand}" ToolTip="{loc:T Menu.Duplicate}" AutomationProperties.Name="{loc:T Menu.Duplicate}" />
        <Button Content="{loc:T Menu.Delete}" Command="{Binding DeleteCommand}" ToolTip="{loc:T Menu.Delete}" AutomationProperties.Name="{loc:T Menu.Delete}" />
        <Button Content="{loc:T Menu.RotateCw}" Command="{Binding RotateClockwiseCommand}" ToolTip="{loc:T Menu.RotateCw}" AutomationProperties.Name="{loc:T Menu.RotateCw}" />
        <Button Content="{loc:T Menu.BringToFront}" Command="{Binding BringToFrontCommand}" ToolTip="{loc:T Menu.BringToFront}" AutomationProperties.Name="{loc:T Menu.BringToFront}" />
        <Button Content="{loc:T Menu.SendToBack}" Command="{Binding SendToBackCommand}" ToolTip="{loc:T Menu.SendToBack}" AutomationProperties.Name="{loc:T Menu.SendToBack}" />
      </ToolBar>
      <ToolBar AutomationProperties.Name="{loc:T Toolbar.View}">
        <Button Content="{loc:T Menu.ZoomOut}" Command="{Binding ZoomOutCommand}" ToolTip="{loc:T Menu.ZoomOut}" AutomationProperties.Name="{loc:T Menu.ZoomOut}" />
        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" AutomationProperties.Name="{loc:T Status.Zoom}" />
        <Button Content="{loc:T Menu.ZoomIn}" Command="{Binding ZoomInCommand}" ToolTip="{loc:T Menu.ZoomIn}" AutomationProperties.Name="{loc:T Menu.ZoomIn}" />
        <Button Content="{loc:T Menu.ZoomFit}" Command="{Binding ZoomFitCommand}" ToolTip="{loc:T Menu.ZoomFit}" AutomationProperties.Name="{loc:T Menu.ZoomFit}" />
        <Button Content="{loc:T Menu.ZoomActual}" Command="{Binding ZoomActualSizeCommand}" ToolTip="{loc:T Menu.ZoomActual}" AutomationProperties.Name="{loc:T Menu.ZoomActual}" />
      </ToolBar>
    </ToolBarTray>

    <!-- ================================ status bar ================================ -->
    <StatusBar DockPanel.Dock="Bottom" AutomationProperties.Name="{loc:T Status.Bar}">
      <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock Text="{Binding SelectionText}" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock Text="{Binding ProblemsText}" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock Text="{Binding CursorText}" MinWidth="150" /></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ApproximateNotice}" Foreground="{StaticResource MutedBrush}" FontStyle="Italic" Margin="0,0,16,0"
                     AutomationProperties.Name="{loc:T Preview.Approximate.Name}" />
          <TextBlock Text="{Binding ZoomText}" MinWidth="48" TextAlignment="Right" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- ================================ left toolbox ================================ -->
    <Border DockPanel.Dock="Left" Width="104" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Panel.Toolbox}" Style="{StaticResource PanelHeading}" AutomationProperties.HeadingLevel="Level1" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding Toolbox}" IsTabStop="False" Margin="4">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="2" Padding="4,6" HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.AddElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Kind}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel>
                    <TextBlock Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" FontFamily="Segoe UI Symbol" />
                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ================================ right column ================================ -->
    <Grid DockPanel.Dock="Right" Width="300" Background="{StaticResource PanelBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="5" />
        <RowDefinition Height="190" MinHeight="90" />
      </Grid.RowDefinitions>
      <views:PropertiesPanel Grid.Row="0" AutomationProperties.Name="{loc:T Panel.Properties}" />
      <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrushLight}" AutomationProperties.Name="{loc:T Splitter.Layers}" />
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Panel.Layers}" Style="{StaticResource PanelHeading}" AutomationProperties.HeadingLevel="Level1" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
          <Button Content="{loc:T Layers.Up}" Command="{Binding BringForwardCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="{loc:T Menu.BringForward}" />
          <Button Content="{loc:T Layers.Down}" Command="{Binding SendBackwardCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="{loc:T Menu.SendBackward}" />
          <Button Content="{loc:T Menu.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="{loc:T Menu.Delete}" />
        </StackPanel>
        <ListBox x:Name="LayersList" ItemsSource="{Binding Layers}" DisplayMemberPath="Name" SelectionMode="Extended"
                 SelectionChanged="OnLayersSelectionChanged" KeyDown="OnLayersKeyDown" BorderThickness="0"
                 AutomationProperties.Name="{loc:T Panel.Layers}" />
      </DockPanel>
    </Grid>

    <!-- ================================ code view (bottom) ================================ -->
    <Border DockPanel.Dock="Bottom" Height="170" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <Button DockPanel.Dock="Right" Content="{loc:T Zpl.Copy}" Command="{Binding CopyZplCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="{loc:T Zpl.Copy}" />
          <TextBlock Text="{loc:T Panel.Zpl}" Style="{StaticResource PanelHeading}" AutomationProperties.HeadingLevel="Level1" />
        </DockPanel>
        <TextBox Text="{Binding ZplText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                 AutomationProperties.Name="{loc:T Panel.Zpl}" />
      </DockPanel>
    </Border>

    <!-- ================================ centre ================================ -->
    <views:DesignArea x:Name="Design" />
  </DockPanel>
</Window>
