<Window x:Class="Rotula.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:ed="clr-namespace:Rotula.App.Editing"
        xmlns:model="clr-namespace:Rotula.Core.Model;assembly=Rotula.Core"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{Binding Title}" Width="1380" Height="860" MinWidth="960" MinHeight="560" WindowStyle="None" SizeChanged="OnWindowSizeChanged"
        AutomationProperties.Name="Rotula">
  <shell:WindowChrome.WindowChrome>
    <!-- The title bar is drawn by the app (warm chrome, app icon, caption buttons) but Windows still handles moving, snapping and resizing. -->
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />

    <!-- Small outlined buttons on the dark ZPL strip. -->
    <Style x:Key="DarkToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource CodeTextBrush}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" BorderBrush="#4A4D57" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2A2C34" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#363944" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows of the Objects list: 48 px tall. -->
    <Style x:Key="LayerRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,8,0" />
    </Style>
    <Style x:Key="ToolbarDivider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="{StaticResource BorderBrushLight}" />
      <Setter Property="Margin" Value="10,0" />
    </Style>

    <!-- Icon of each toolbox tool, chosen by the kind of element it creates. -->
    <Style x:Key="ToolIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Text"><Setter Property="Data" Value="{StaticResource IconText}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="DataField"><Setter Property="Data" Value="{StaticResource IconDataField}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Barcode"><Setter Property="Data" Value="{StaticResource IconBarcode}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="QrCode"><Setter Property="Data" Value="{StaticResource IconQr}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Box"><Setter Property="Data" Value="{StaticResource IconRectangle}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Line"><Setter Property="Data" Value="{StaticResource IconLine}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Circle"><Setter Property="Data" Value="{StaticResource IconCircle}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Image"><Setter Property="Data" Value="{StaticResource IconImage}" /></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCommand}" />
    <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ShowDataCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
    <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}" />
    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}" />
    <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RotateClockwiseCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RotateCounterClockwiseCommand}" />
    <KeyBinding Key="F3" Command="{Binding SelectNextCommand}" />
    <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding SelectPreviousCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomActualSizeCommand}" />
    <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding ZoomFitCommand}" />
  </Window.InputBindings>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- ================================ title bar ================================ -->
    <Grid Grid.Row="0" Background="{StaticResource WindowBrush}">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
        <Border Width="24" Height="24" CornerRadius="6" Background="#1F2023" AutomationProperties.Name="Rotula">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconBarcode}" Width="14" Height="14" StrokeThickness="1.8" TextElement.Foreground="White" />
        </Border>
        <TextBlock Text="{Binding TitleBarText}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="{loc:T Window.Minimize}" AutomationProperties.Name="{loc:T Window.Minimize}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconMinimize}" Width="12" Height="12" />
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="{loc:T Window.Maximize}" AutomationProperties.Name="{loc:T Window.Maximize}">
          <Path x:Name="MaximizeGlyph" Style="{StaticResource Icon}" Data="{StaticResource IconMaximize}" Width="11" Height="11" />
        </Button>
        <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseWindow" ToolTip="{loc:T Window.Close}" AutomationProperties.Name="{loc:T Window.Close}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" Width="12" Height="12" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ================================ menu ================================ -->
    <Menu Grid.Row="1" Margin="8,0,8,4" AutomationProperties.Name="{loc:T Menu.Main}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <MenuItem Header="{loc:T Menu.File}">
        <MenuItem Header="{loc:T Menu.New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Header="{loc:T Menu.Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Header="{loc:T Menu.Recent}" ItemsSource="{Binding RecentFiles}">
          <MenuItem.Style>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Style.Triggers>
                <Trigger Property="HasItems" Value="False"><Setter Property="IsEnabled" Value="False" /></Trigger>
              </Style.Triggers>
            </Style>
          </MenuItem.Style>
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Display}" />
              <Setter Property="ToolTip" Value="{Binding Path}" />
              <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:T Menu.Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="{loc:T Menu.SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Export}">
          <MenuItem Header="{loc:T Menu.ExportPng}" Command="{Binding ExportPngCommand}" />
          <MenuItem Header="{loc:T Menu.ExportPdf}" Command="{Binding ExportPdfCommand}" />
          <MenuItem Header="{loc:T Menu.ExportZpl}" Command="{Binding ExportZplCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.ImportZpl}" Command="{Binding ImportZplCommand}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Exit}" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Edit}">
        <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Cut}" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
        <MenuItem Header="{loc:T Menu.Copy}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
        <MenuItem Header="{loc:T Menu.Paste}" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
        <MenuItem Header="{loc:T Menu.Duplicate}" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
        <MenuItem Header="{loc:T Menu.Delete}" Command="{Binding DeleteCommand}" InputGestureText="Del" />
        <Separator />
        <MenuItem Header="{loc:T Menu.SelectAll}" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
        <MenuItem Header="{loc:T Menu.SelectNext}" Command="{Binding SelectNextCommand}" InputGestureText="F3" />
        <MenuItem Header="{loc:T Menu.SelectPrevious}" Command="{Binding SelectPreviousCommand}" InputGestureText="Shift+F3" />
      </MenuItem>

      <MenuItem Header="{loc:T Menu.View}">
        <MenuItem Header="{loc:T Menu.ZoomIn}" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
        <MenuItem Header="{loc:T Menu.ZoomOut}" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
        <MenuItem Header="{loc:T Menu.ZoomActual}" Command="{Binding ZoomActualSizeCommand}" InputGestureText="Ctrl+0" />
        <MenuItem Header="{loc:T Menu.ZoomFit}" Command="{Binding ZoomFitCommand}" InputGestureText="Ctrl+9" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Units}">
          <MenuItem Header="{loc:T Menu.UnitMm}" Command="{Binding SetUnitCommand}" CommandParameter="{x:Static model:LengthUnit.Millimeters}" IsChecked="{Binding IsUnitMm, Mode=OneWay}" />
          <MenuItem Header="{loc:T Menu.UnitInch}" Command="{Binding SetUnitCommand}" CommandParameter="{x:Static model:LengthUnit.Inches}" IsChecked="{Binding IsUnitInch, Mode=OneWay}" />
          <MenuItem Header="{loc:T Menu.UnitDots}" Command="{Binding SetUnitCommand}" CommandParameter="{x:Static model:LengthUnit.Dots}" IsChecked="{Binding IsUnitDots, Mode=OneWay}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.ShowZpl}" IsCheckable="True" IsChecked="{Binding ZplPanelVisible, Mode=TwoWay}" />
        <MenuItem Header="{loc:T Menu.Grid}" IsCheckable="True" IsChecked="{Binding GridVisible, Mode=TwoWay}" />
        <MenuItem Header="{loc:T Menu.SnapGrid}" IsCheckable="True" IsChecked="{Binding SnapToGrid, Mode=TwoWay}" />
        <MenuItem Header="{loc:T Menu.SnapGuides}" IsCheckable="True" IsChecked="{Binding SnapToGuides, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Language}">
          <MenuItem Header="{loc:T Menu.LanguageAuto}" Command="{Binding SetLanguageCommand}" CommandParameter="auto" IsChecked="{Binding IsLanguageAuto, Mode=OneWay}" />
          <MenuItem Header="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" IsChecked="{Binding IsLanguageEn, Mode=OneWay}" />
          <MenuItem Header="Espa&#241;ol" Command="{Binding SetLanguageCommand}" CommandParameter="es" IsChecked="{Binding IsLanguageEs, Mode=OneWay}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Label}">
        <MenuItem Header="{loc:T Menu.LabelProperties}" Command="{Binding SelectNoneCommand}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.Arrange}">
          <MenuItem Header="{loc:T Menu.BringToFront}" Command="{Binding BringToFrontCommand}" />
          <MenuItem Header="{loc:T Menu.BringForward}" Command="{Binding BringForwardCommand}" />
          <MenuItem Header="{loc:T Menu.SendBackward}" Command="{Binding SendBackwardCommand}" />
          <MenuItem Header="{loc:T Menu.SendToBack}" Command="{Binding SendToBackCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.RotateCw}" Command="{Binding RotateClockwiseCommand}" InputGestureText="Ctrl+R" />
        <MenuItem Header="{loc:T Menu.RotateCcw}" Command="{Binding RotateCounterClockwiseCommand}" InputGestureText="Ctrl+Shift+R" />
        <MenuItem Header="{loc:T Menu.Align}">
          <MenuItem Header="{loc:T Menu.AlignLeft}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Left}" />
          <MenuItem Header="{loc:T Menu.AlignCenterH}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.CenterHorizontal}" />
          <MenuItem Header="{loc:T Menu.AlignRight}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Right}" />
          <MenuItem Header="{loc:T Menu.AlignTop}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Top}" />
          <MenuItem Header="{loc:T Menu.AlignCenterV}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.CenterVertical}" />
          <MenuItem Header="{loc:T Menu.AlignBottom}" Command="{Binding AlignCommand}" CommandParameter="{x:Static ed:AlignKind.Bottom}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.Distribute}">
          <MenuItem Header="{loc:T Menu.DistributeH}" Command="{Binding DistributeCommand}" CommandParameter="{x:Static ed:DistributeKind.Horizontal}" />
          <MenuItem Header="{loc:T Menu.DistributeV}" Command="{Binding DistributeCommand}" CommandParameter="{x:Static ed:DistributeKind.Vertical}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Printer}">
        <MenuItem Header="{loc:T Menu.Print}" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
        <MenuItem Header="{loc:T Menu.RefreshPrinters}" Command="{Binding RefreshPrintersCommand}" />
        <Separator />
        <MenuItem Header="{loc:T Menu.DataMerge}" Command="{Binding ShowDataCommand}" InputGestureText="Ctrl+M" />
        <MenuItem Header="{loc:T Menu.OpenData}" Command="{Binding OpenDataFileCommand}" />
      </MenuItem>

      <MenuItem Header="{loc:T Menu.Help}">
        <MenuItem Header="{loc:T Menu.About}" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- ================================ toolbar ================================ -->
    <Border Grid.Row="2" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1">
      <DockPanel Margin="12,0">
        <!-- right: printer, preview, print -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PrinterCaption" Text="{loc:T Toolbar.Printer}" Style="{StaticResource ToolbarLabel}" />
          <Grid x:Name="PrinterBox" Width="210">
            <ComboBox x:Name="PrinterCombo" ItemsSource="{Binding Printer.Printers}" SelectedValuePath="Name" SelectedValue="{Binding Printer.SelectedPrinterName}"
                      SelectionChanged="OnPrinterChosen" AutomationProperties.Name="{loc:T Toolbar.Printer}" ToolTip="{loc:T Toolbar.Printer.Tip}">
              <ComboBox.ItemTemplate>
                <!-- Long printer names (and the longer Spanish suffixes) get an ellipsis instead of being cut off. -->
                <DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border IsHitTestVisible="False" Margin="2,2,30,2" Background="{StaticResource SurfaceBrush}" CornerRadius="5" Visibility="{Binding Printer.ShowToolbarText, Converter={StaticResource B2V}}">
              <TextBlock Text="{Binding Printer.ToolbarText}" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
            </Border>
          </Grid>
          <Button Margin="12,0,0,0" Command="{Binding ShowPreviewCommand}" ToolTip="{loc:T Toolbar.Preview.Tip}" AutomationProperties.Name="{loc:T Toolbar.Preview}">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="PreviewIcon" Style="{StaticResource Icon}" Data="{StaticResource IconEye}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock x:Name="PreviewText" Text="{loc:T Toolbar.Preview}" />
            </StackPanel>
          </Button>
          <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding PrintCommand}" ToolTip="{loc:T Toolbar.Print.Tip}" AutomationProperties.Name="{loc:T Menu.Print}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconPrinter}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="{loc:T Toolbar.Print}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- left: file, history, zoom, label, data -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding NewCommand}" ToolTip="{loc:T Menu.New}" AutomationProperties.Name="{loc:T Menu.New}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconNew}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding OpenCommand}" ToolTip="{loc:T Menu.Open}" AutomationProperties.Name="{loc:T Menu.Open}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconOpen}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding SaveCommand}" ToolTip="{loc:T Menu.Save}" AutomationProperties.Name="{loc:T Menu.Save}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSave}" />
          </Button>
          <Border Style="{StaticResource ToolbarDivider}" />
          <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoText}" AutomationProperties.Name="{loc:T Menu.Undo}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconUndo}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoText}" AutomationProperties.Name="{loc:T Menu.Redo}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconRedo}" />
          </Button>
          <Border Style="{StaticResource ToolbarDivider}" />
          <TextBlock x:Name="ZoomCaption" Text="{loc:T Toolbar.Zoom}" Style="{StaticResource ToolbarLabel}" />
          <Grid Width="96">
            <ComboBox x:Name="ZoomCombo" ItemsSource="{Binding ZoomPresets}" ItemStringFormat="{}{0} %" SelectionChanged="OnZoomPresetChosen" AutomationProperties.Name="{loc:T Status.Zoom}" />
            <!-- The box shows the live zoom (which is not always one of the presets); picking a preset applies it. -->
            <Border IsHitTestVisible="False" Margin="2,2,30,2" Background="{StaticResource SurfaceBrush}" CornerRadius="5">
              <TextBlock Text="{Binding ZoomText}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
            </Border>
          </Grid>
          <TextBlock x:Name="LabelCaption" Text="{loc:T Toolbar.Label}" Style="{StaticResource ToolbarLabel}" Margin="16,0,8,0" />
          <!-- Size picker: opens a menu with the common sizes, "Custom size..." and the print resolution (built in code so it is always current and translated). -->
          <Button x:Name="LabelPickerButton" Click="OnLabelPickerClick" MinWidth="190" ToolTip="{loc:T Picker.Tip}" AutomationProperties.Name="{loc:T Panel.Size}"
                  AutomationProperties.HelpText="{loc:T Picker.Tip}" HorizontalContentAlignment="Stretch">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource Icon}" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="10,0,0,0" />
              <TextBlock Text="{Binding LabelSummaryText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" />
            </DockPanel>
          </Button>
          <Border Style="{StaticResource ToolbarDivider}" />
          <ToggleButton Style="{StaticResource RailToolButton}" Width="38" Height="38" Margin="1,0" IsChecked="{Binding ZplPanelVisible, Mode=TwoWay}" ToolTip="{loc:T Toolbar.ZplToggle}"
                        AutomationProperties.Name="{loc:T Menu.ShowZpl}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCode}" />
          </ToggleButton>
          <Button Style="{StaticResource IconButton}" Command="{Binding ShowDataCommand}" ToolTip="{loc:T Menu.DataMerge}" AutomationProperties.Name="{loc:T Menu.DataMerge}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconDatabase}" />
          </Button>
          <StackPanel Orientation="Horizontal" Visibility="{Binding Data.HasData, Converter={StaticResource B2V}}">
            <Button Style="{StaticResource IconButton}" Width="30" Command="{Binding PreviousRecordCommand}" ToolTip="{loc:T Data.Record.Previous}" AutomationProperties.Name="{loc:T Data.Record.Previous}">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconPrevious}" Width="14" Height="14" />
            </Button>
            <TextBlock Text="{Binding DataRecordText}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" MinWidth="100" TextAlignment="Center"
                       AutomationProperties.Name="{loc:T Data.Record.Current}" />
            <Button Style="{StaticResource IconButton}" Width="30" Command="{Binding NextRecordCommand}" ToolTip="{loc:T Data.Record.Next}" AutomationProperties.Name="{loc:T Data.Record.Next}">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconNext}" Width="14" Height="14" />
            </Button>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================================ workspace ================================ -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="9" />
        <ColumnDefinition Width="380" MinWidth="300" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- tool rail -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" AutomationProperties.Name="{loc:T Panel.Toolbox}">
          <StackPanel HorizontalAlignment="Center" Margin="0,12">
            <ToggleButton x:Name="SelectTool" Style="{StaticResource RailToolButton}" IsChecked="True" Click="OnSelectTool" ToolTip="{loc:T Tool.Select}" AutomationProperties.Name="{loc:T Tool.Select}">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconSelect}" Width="22" Height="22" />
            </ToggleButton>
            <ItemsControl ItemsSource="{Binding Toolbox}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RailCommandButton}" Command="{Binding DataContext.AddElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding Kind}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                    <Path Style="{StaticResource ToolIcon}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- canvas -->
      <views:DesignArea x:Name="Design" Grid.Column="1" Grid.Row="0" />

      <!-- start screen: covers the canvas while no label has been created or opened yet -->
      <Border x:Name="StartScreen" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource WorkspaceBrush}" Visibility="{Binding ShowStartScreen, Converter={StaticResource B2V}}"
              AutomationProperties.Name="{loc:T Start.Name}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel MaxWidth="700" Margin="32,40,32,32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{loc:T Start.Title}" FontSize="28" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{loc:T Start.Subtitle}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,24" />
            <WrapPanel>
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource StartCardButton}">
                  <Setter Property="Width" Value="212" />
                  <Setter Property="Margin" Value="0,0,12,12" />
                </Style>
              </WrapPanel.Resources>
              <Button x:Name="StartNewButton" Command="{Binding NewCommand}" AutomationProperties.Name="{loc:T Start.New}" AutomationProperties.HelpText="{loc:T Start.New.Desc}">
                <StackPanel>
                  <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentTintBrush}" HorizontalAlignment="Left">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconNew}" Width="20" Height="20" TextElement.Foreground="{StaticResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{loc:T Start.New}" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" />
                  <TextBlock Text="{loc:T Start.New.Desc}" Style="{StaticResource MutedText}" FontSize="12" MinHeight="48" />
                </StackPanel>
              </Button>
              <Button Command="{Binding OpenCommand}" AutomationProperties.Name="{loc:T Start.Open}" AutomationProperties.HelpText="{loc:T Start.Open.Desc}">
                <StackPanel>
                  <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentTintBrush}" HorizontalAlignment="Left">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconOpen}" Width="20" Height="20" TextElement.Foreground="{StaticResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{loc:T Start.Open}" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" />
                  <TextBlock Text="{loc:T Start.Open.Desc}" Style="{StaticResource MutedText}" FontSize="12" MinHeight="48" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ImportZplCommand}" AutomationProperties.Name="{loc:T Start.Import}" AutomationProperties.HelpText="{loc:T Start.Import.Desc}">
                <StackPanel>
                  <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentTintBrush}" HorizontalAlignment="Left">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCode}" Width="20" Height="20" TextElement.Foreground="{StaticResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{loc:T Start.Import}" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" />
                  <TextBlock Text="{loc:T Start.Import.Desc}" Style="{StaticResource MutedText}" FontSize="12" MinHeight="48" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <TextBlock Text="{loc:T Start.Recent}" Style="{StaticResource SectionHeading}" Margin="0,12,0,8" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}" Padding="8" MaxWidth="660" HorizontalAlignment="Left" MinWidth="360">
              <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170" Focusable="False">
                  <ItemsControl ItemsSource="{Binding RecentFiles}" AutomationProperties.Name="{loc:T Start.Recent}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Style="{StaticResource ListRowButton}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Display}">
                          <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Width="18" Height="18" Margin="0,0,10,0" TextElement.Foreground="{StaticResource MutedBrush}" />
                            <StackPanel>
                              <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{loc:T Start.Recent.None}" Margin="10,10">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RecentFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>

            <Button Style="{StaticResource LinkButton}" Content="{loc:T Start.Blank}" Command="{Binding DismissStartScreenCommand}" Margin="0,16,0,0"
                    AutomationProperties.Name="{loc:T Start.Blank}" />
            <TextBlock Text="{loc:T Start.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,10,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource SplitterVerticalStyle}" ResizeBehavior="PreviousAndNext"
                    AutomationProperties.Name="{loc:T Splitter.Properties}" />

      <!-- right column: properties and objects -->
      <Grid x:Name="RightColumn" Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PanelBrush}">
        <!-- Properties about 55 % / Objects about 45 % by default; the splitter position is remembered (as a share) in settings.json. -->
        <Grid.RowDefinitions>
          <RowDefinition x:Name="PropertiesRow" Height="55*" MinHeight="200" />
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="ObjectsRow" Height="45*" MinHeight="170" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1,0,0,0" />
        <views:PropertiesPanel x:Name="PropertiesPanelView" Grid.Row="0" AutomationProperties.Name="{loc:T Panel.Properties}" />
        <GridSplitter x:Name="PanelSplitter" Grid.Row="1" Style="{StaticResource SplitterHorizontalStyle}" DragCompleted="OnPanelSplitterDragCompleted"
                      AutomationProperties.Name="{loc:T Splitter.Layers}" />
        <DockPanel Grid.Row="2">
          <!-- Objects header: title, count and the icon buttons that act on the selected objects. -->
          <DockPanel DockPanel.Dock="Top" Margin="16,8,12,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource PanelIconButton}" Command="{Binding BringForwardCommand}" ToolTip="{loc:T Menu.BringForward}" AutomationProperties.Name="{loc:T Menu.BringForward}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowUp}" Width="16" Height="16" />
              </Button>
              <Button Style="{StaticResource PanelIconButton}" Command="{Binding SendBackwardCommand}" ToolTip="{loc:T Menu.SendBackward}" AutomationProperties.Name="{loc:T Menu.SendBackward}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowDown}" Width="16" Height="16" />
              </Button>
              <Button Style="{StaticResource PanelIconButton}" Command="{Binding DeleteCommand}" ToolTip="{loc:T Menu.Delete}" AutomationProperties.Name="{loc:T Menu.Delete}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" Width="16" Height="16" />
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{loc:T Panel.Objects}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
              <Border Background="{StaticResource HoverBrush}" CornerRadius="9" Padding="7,1" Margin="8,1,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Layers.Count}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
              </Border>
            </StackPanel>
          </DockPanel>
          <Grid>
            <ListBox x:Name="LayersList" ItemsSource="{Binding Layers}" SelectionMode="Extended" SelectionChanged="OnLayersSelectionChanged" KeyDown="OnLayersKeyDown"
                     Grid.IsSharedSizeScope="True" AutomationProperties.Name="{loc:T Panel.Objects}" ItemContainerStyle="{StaticResource LayerRowStyle}" Padding="0,0,0,8">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- Type tag in a column shared by all rows (so the names line up); the text is trimmed with an ellipsis and the tooltip shows it in full. -->
                  <Grid ToolTip="{Binding ToolTipText}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="LayerTag" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TypeTag}" MaxWidth="104" Margin="0,0,12,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Empty state: shown only while the list has no objects. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,16" IsHitTestVisible="False">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Layers.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconLayers}" Width="32" Height="32" StrokeThickness="1.3" TextElement.Foreground="{StaticResource DisabledTextBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:T Layers.Empty.Title}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
              <TextBlock Text="{loc:T Layers.Empty.Hint}" Style="{StaticResource MutedText}" TextAlignment="Center" FontSize="12" MaxWidth="260" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Grid>

      <!-- ZPL output (a dark code surface by design; everything else stays light) -->
      <Border Grid.Row="1" Grid.Column="1" Height="190" Background="{StaticResource CodeBackgroundBrush}"
              Visibility="{Binding ZplPanelVisible, Converter={StaticResource B2V}}">
        <Border.Resources>
          <!-- The only dark surface: lighter scrollbar thumbs so they show on the charcoal background. -->
          <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4B4E59" />
          <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6A6E7B" />
          <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#8A8E9B" />
        </Border.Resources>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,10,12,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{loc:T Zpl.Copy}" Command="{Binding CopyZplCommand}" Style="{StaticResource DarkToolButton}" AutomationProperties.Name="{loc:T Zpl.Copy}" />
              <Button Content="{loc:T Zpl.ExportButton}" Command="{Binding ExportZplCommand}" Style="{StaticResource DarkToolButton}" AutomationProperties.Name="{loc:T Zpl.ExportButton}" />
            </StackPanel>
            <TextBlock Text="{loc:T Zpl.Output}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource CodeMutedBrush}"
                       AutomationProperties.HeadingLevel="Level1" />
          </DockPanel>
          <TextBox Text="{Binding ZplText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Background="Transparent" Foreground="{StaticResource CodeTextBrush}"
                   BorderThickness="0" Padding="12,2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalContentAlignment="Top"
                   CaretBrush="White" AutomationProperties.Name="{loc:T Panel.Zpl}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ================================ status bar ================================ -->
    <!--
      A grid, not a StatusBar: only a star column can shrink, so the message and the notice are the parts that get an ellipsis when the window
      is narrow, while counts, problems, pointer and label size always stay readable. Segments are divided by hairlines.
    -->
    <StatusBar Grid.Row="4" Background="{StaticResource StatusBarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="16,0"
               AutomationProperties.Name="{loc:T Status.Bar}">
      <StatusBarItem HorizontalContentAlignment="Stretch" Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="0" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- left: counts, then the transient message -->
        <TextBlock Text="{Binding ObjectsText}" Style="{StaticResource StatusText}" TextTrimming="None" />
        <!-- The divider belongs to the message: with no message there is nothing to divide, so no stray hairline is left. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatusMessage}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border Style="{StaticResource StatusSeparator}" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" ToolTip="{Binding StatusMessage}" />
        </StackPanel>
        <!-- right: problems, notice (short; the full explanation is the tooltip), pointer, label size -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ProblemsText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border Style="{StaticResource StatusSeparator}" />
          <TextBlock Text="{Binding ProblemsText}" Style="{StaticResource StatusText}" TextTrimming="None" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" ToolTip="{Binding ApproximateNotice}" Background="Transparent">
          <Border Style="{StaticResource StatusSeparator}" />
          <TextBlock Text="{Binding ApproximateNoticeShort}" Style="{StaticResource StatusText}" TextTrimming="None" FontStyle="Italic" AutomationProperties.Name="{loc:T Preview.Approximate.Name}"
                     AutomationProperties.HelpText="{Binding ApproximateNotice}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <StackPanel.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
              <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
              <Setter Property="FontSize" Value="11.5" />
              <Setter Property="TextTrimming" Value="None" />
            </Style>
          </StackPanel.Resources>
          <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CursorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Style="{StaticResource StatusSeparator}" />
            <TextBlock Text="{Binding CursorText}" MinWidth="120" />
          </StackPanel>
          <Border Style="{StaticResource StatusSeparator}" />
          <TextBlock Text="{Binding StatusLabelText}" AutomationProperties.Name="{loc:T Status.LabelInfo}" />
        </StackPanel>
      </Grid>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
