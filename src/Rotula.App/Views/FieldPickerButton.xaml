<UserControl x:Class="Rotula.App.Views.FieldPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rotula.App.Localization"
             Focusable="False" IsTabStop="False">
  <UserControl.Resources>
    <!-- Insert mode: a small outlined button. Bind mode: one half of the "Fixed value | Field" switch (lit when the content is a field). -->
    <Style x:Key="PickerToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="6" MinHeight="28" Padding="9,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="Brace" Style="{StaticResource Icon}" Data="{StaticResource IconDataField}" Width="14" Height="14" TextElement.Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="Caption" Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{TemplateBinding Foreground}" />
                <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Margin="7,1,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentTintBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" MinHeight="26" Padding="10,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Caption" Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Path x:Name="Chev" Data="M0,0 L3.5,3.5 L7,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Margin="6,1,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" /></Trigger>
              <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Chev" Property="Stroke" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ToggleButton x:Name="Toggle" Style="{StaticResource PickerToggle}" Checked="OnToggleChecked" Unchecked="OnToggleUnchecked"
                  ToolTipService.ShowOnDisabled="True" />
    <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
           PopupAnimation="Fade" Opened="OnOpened" Closed="OnClosed">
      <Border Width="320" Margin="0,4,12,12" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#000000" /></Border.Effect>
        <StackPanel KeyboardNavigation.TabNavigation="Cycle">
          <TextBlock x:Name="CountText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="14,10,14,6" AutomationProperties.LiveSetting="Polite" />
          <TextBox x:Name="Search" Margin="8,0,8,6" MinHeight="32" Padding="10,0" FontSize="12.5" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                   AutomationProperties.Name="{loc:T Fields.Search}" />
          <ListBox x:Name="List" MaxHeight="252" PreviewKeyDown="OnListKeyDown" PreviewMouseLeftButtonUp="OnListClick" AutomationProperties.Name="{loc:T Fields.List}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          <TextBlock Text="{loc:T Fields.Keys}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="14,4,14,10" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
