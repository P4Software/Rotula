<Window x:Class="Rotula.App.Views.StationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Rotula.App.Controls"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        Title="{Binding Title}" Width="1280" Height="860" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="18" UseLayoutRounding="True"
        AutomationProperties.Name="{Binding Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
    <views:StationImageConverter x:Key="StationImage" />

    <!-- Touch-friendly sizes: fields and buttons are large enough for a gloved finger, text readable at arm's length. -->
    <Style x:Key="StationTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style x:Key="StationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Padding" Value="24,0" />
    </Style>
    <Style x:Key="StationPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Padding" Value="24,0" />
    </Style>
    <Style x:Key="StationPrintButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="FontSize" Value="32" />
      <Setter Property="Padding" Value="32,0" />
    </Style>

    <!-- One question: caption, a large input (a text box, or an editable list for a choice so a scan can still type into it), help and the refusal. -->
    <DataTemplate DataType="{x:Type vms:PromptFieldViewModel}">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="{Binding Caption}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="Answer" Tag="StationField" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"
                 AutomationProperties.Name="{Binding Caption}" AutomationProperties.HelpText="{Binding Help}"
                 ctl:FieldState.HasError="{Binding HasError}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource StationTextBox}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <ComboBox Tag="StationField" ItemsSource="{Binding Choices}" IsEditable="True" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                  MinHeight="60" FontSize="26" AutomationProperties.Name="{Binding Caption}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>
        <TextBlock Text="{Binding Help}" Style="{StaticResource MutedText}" FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasHelp, Converter={StaticResource B2V}}" />
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <DockPanel x:Name="MainArea">
      <!-- ============================== header: title and Exit only (no menus, no design tools) -->
      <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="24,12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{loc:T Station.Exit}" Style="{StaticResource StationButton}" Command="{Binding RequestExitCommand}"
                  AutomationProperties.Name="{loc:T Station.Exit}" />
          <Button DockPanel.Dock="Left" Content="{loc:T Station.Back}" Style="{StaticResource StationButton}" Margin="0,0,16,0" Command="{Binding BackToListCommand}"
                  AutomationProperties.Name="{loc:T Station.Back}">
            <Button.Visibility>
              <MultiBinding Converter="{x:Static views:StationWindow.AllTrue}">
                <Binding Path="IsLabelOpen" />
                <Binding Path="CanGoBack" />
              </MultiBinding>
            </Button.Visibility>
          </Button>
          <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.HeadingLevel="Level1" />
        </DockPanel>
      </Border>

      <Grid>
        <!-- ============================== the label list -->
        <DockPanel Margin="24,20,24,0" Visibility="{Binding IsChoosing, Converter={StaticResource B2V}}">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{loc:T Station.Search}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="SearchBox" Style="{StaticResource StationTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:T Station.Search}" AutomationProperties.HelpText="{loc:T Station.Search.Hint}" />
            <TextBlock Text="{loc:T Station.Search.Hint}" Style="{StaticResource MutedText}" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap" />
            <Border Style="{StaticResource ErrorBanner}" Margin="0,12,0,0" Padding="16,12" Visibility="{Binding HasSearchMessage, Converter={StaticResource B2V}}"
                    AutomationProperties.LiveSetting="Assertive">
              <TextBlock Text="{Binding SearchMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}">
              <StackPanel>
                <TextBlock Text="{loc:T Station.Warnings}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding WarningsText}" Foreground="{StaticResource WarningBrush}" FontSize="16" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="{loc:T Station.NoMatch}" Style="{StaticResource MutedText}" FontSize="20" Margin="0,24,0,0"
                       Visibility="{Binding NoLabelsFound, Converter={StaticResource B2V}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,16,0,0" PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding VisibleLabels}" Focusable="False" Margin="0,0,0,24">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vms:StationLabelViewModel}">
                  <Button Width="300" Height="320" Margin="0,0,16,16" Padding="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          Command="{Binding DataContext.OpenLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                          IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Name}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Key}" Style="{StaticResource MutedText}" FontSize="16" HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Visibility="{Binding HasKey, Converter={StaticResource B2V}}" />
                      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Margin="0,10,0,2" />
                      <Border Background="{StaticResource WorkspaceDotBrush}" CornerRadius="6" Padding="8">
                        <Image Source="{Binding Thumbnail, Converter={StaticResource StationImage}}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Name}" />
                      </Border>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- ============================== the open label: questions, quantity, Print, status | live preview -->
        <Grid Margin="24,20,24,24" Visibility="{Binding IsLabelOpen, Converter={StaticResource B2V}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="4*" />
          </Grid.ColumnDefinitions>

          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
              <TextBlock Text="{Binding Current.Name}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{Binding PrinterText}" Style="{StaticResource MutedText}" FontSize="17" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status: big and plain, so it can be read from a step away. -->
            <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="20,16" CornerRadius="8" BorderThickness="2"
                    Visibility="{Binding HasStatus, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusIsGood}" Value="True">
                      <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                      <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusIsBad}" Value="True">
                      <Setter Property="Background" Value="{StaticResource ErrorTintBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                      <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{loc:T Common.StopOperation}" Style="{StaticResource StationButton}" Margin="16,0,0,0"
                          Command="{Binding CancelOperationCommand}" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"
                          AutomationProperties.Name="{loc:T Common.StopOperation}" />
                  <TextBlock Text="{Binding StatusTitle}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"
                             AutomationProperties.Name="{Binding StatusTitle}" />
                <TextBlock Text="{Binding StatusDetail}" FontSize="19" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasStatusDetail, Converter={StaticResource B2V}}" />
              </StackPanel>
            </Border>

            <!-- Quantity and Print stay at the bottom of the column, always in the same place. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{loc:T Station.Copies}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="CopiesBox" Style="{StaticResource StationTextBox}" Width="180" Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:T Station.Copies}" AutomationProperties.HelpText="{Binding CopiesHint}" />
                <TextBlock Text="{Binding CopiesHint}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <Button x:Name="PrintButton" Content="{loc:T Station.Print}" Style="{StaticResource StationPrintButton}" Command="{Binding PrintCommand}"
                        IsEnabled="{Binding CanPrint}" AutomationProperties.Name="{loc:T Station.Print}" Margin="0,0,0,22" />
              </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding ShowRecords, Converter={StaticResource B2V}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T Station.PrintRecords}" Style="{StaticResource StationButton}" Margin="16,0,0,0"
                        Command="{Binding PrintRecordsCommand}" IsEnabled="{Binding CanPrintRecords}" AutomationProperties.Name="{loc:T Station.PrintRecords}" />
                <TextBlock Text="{Binding RecordsText}" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <ScrollViewer x:Name="FieldsScroller" VerticalScrollBarVisibility="Auto" Focusable="False" PanningMode="VerticalOnly">
              <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{loc:T Station.Fields.None}" Style="{StaticResource MutedText}" FontSize="20" TextWrapping="Wrap"
                           Visibility="{Binding HasNoFields, Converter={StaticResource B2V}}" />
                <ItemsControl x:Name="FieldsList" ItemsSource="{Binding Fields}" Focusable="False" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Station.Preview}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Bottom" Text="{loc:T Preview.Approximate}" Style="{StaticResource MutedText}" FontStyle="Italic" FontSize="15" Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <Border Background="{StaticResource WorkspaceDotBrush}" CornerRadius="8" Padding="24">
              <Border Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Preview, Converter={StaticResource StationImage}}" Stretch="Uniform" StretchDirection="Both"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{loc:T Station.Preview}" />
              </Border>
            </Border>
          </DockPanel>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- ============================== PIN to leave -->
    <Grid Background="#99281E14" Visibility="{Binding IsPinPromptOpen, Converter={StaticResource B2V}}">
      <Border Style="{StaticResource Card}" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{loc:T Station.Pin.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{loc:T Station.Pin.Field}" FontSize="18" Margin="0,16,0,6" />
          <PasswordBox x:Name="PinBox" MinHeight="60" FontSize="26" Padding="16,0" MaxLength="32" AutomationProperties.Name="{loc:T Station.Pin.Field}" />
          <TextBlock Text="{Binding PinError}" Foreground="{StaticResource ErrorBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding HasPinError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{loc:T Common.Cancel}" Style="{StaticResource StationButton}" Margin="0,0,12,0" Command="{Binding CancelExitCommand}"
                    AutomationProperties.Name="{loc:T Common.Cancel}" />
            <Button x:Name="PinOk" Content="{loc:T Station.Pin.Ok}" Style="{StaticResource StationPrimaryButton}" Click="OnPinOk"
                    AutomationProperties.Name="{loc:T Station.Pin.Ok}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
