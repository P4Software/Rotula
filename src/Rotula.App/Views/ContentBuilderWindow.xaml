<views:DialogWindow x:Class="Rotula.App.Views.ContentBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        xmlns:ctl="clr-namespace:Rotula.App.Controls"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        Title="{loc:T QrContent.Title}" Width="1120" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T QrContent.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
    <views:MatrixImageConverter x:Key="MatrixImage" />

    <!--
      One field of the form. The label row carries the Insert field button (the same control the property panel uses). Text-like fields get a
      text box with the {{ autocomplete; a choice, a flag and a date get their own control while they are fixed, and show the placeholder
      (with a way back to a fixed value) once bound to a data column.
    -->
    <DataTemplate DataType="{x:Type vms:QrFieldEditor}">
      <StackPanel Margin="0,0,0,16">
        <DockPanel Margin="0,0,0,4">
          <views:FieldPickerButton DockPanel.Dock="Right" Caption="{loc:T Fields.Insert}" Row="{Binding Row}" Status="{Binding Label}" Target="{Binding ElementName=Box}"
                                   ReplaceAll="{Binding ReplacesWhole}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LabelText}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- text, and the bound state of every kind of field -->
        <TextBox x:Name="Box" Text="{Binding Row.Text, UpdateSourceTrigger=PropertyChanged}" IsUndoEnabled="False" TextWrapping="Wrap"
                 AcceptsReturn="{Binding IsMultiline}" ctl:FieldBox.Row="{Binding Row}" ctl:FieldState.HasError="{Binding HasError}"
                 AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Hint}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                  <Setter Property="MinHeight" Value="76" />
                  <Setter Property="Padding" Value="12,9" />
                  <Setter Property="VerticalContentAlignment" Value="Top" />
                  <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsText}" Value="False" />
                    <Condition Binding="{Binding IsFixed}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsBound}" Value="True">
                  <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>

        <!-- a choice -->
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Display" AutomationProperties.Name="{Binding Label}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChoice}" Value="True" />
                    <Condition Binding="{Binding IsFixed}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>

        <!-- a yes/no -->
        <CheckBox Content="{loc:T QrContent.Flag.On}" IsChecked="{Binding Flag}" AutomationProperties.Name="{Binding Label}">
          <CheckBox.Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFlag}" Value="True" />
                    <Condition Binding="{Binding IsFixed}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </CheckBox.Style>
        </CheckBox>

        <!-- a date and time: a date picker and the time of day; the text under them shows what is written into the code -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDateTime}" Value="True" />
                    <Condition Binding="{Binding IsFixed}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <DockPanel>
            <Grid DockPanel.Dock="Right" Width="96" Margin="8,0,0,0">
              <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" ctl:FieldState.HasError="{Binding TimeInvalid}"
                       AutomationProperties.Name="{Binding Label, StringFormat={}{0} (HH:mm)}" ToolTip="{loc:T QrContent.Time.Tip}" />
              <TextBlock Text="HH:mm" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource DisabledTextBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding TimeText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <DatePicker SelectedDate="{Binding Date}" AutomationProperties.Name="{Binding Label}" />
          </DockPanel>
          <TextBlock Text="{Binding Row.Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                     TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Row.Text}" />
        </StackPanel>

        <!-- back to a fixed value -->
        <Button Command="{Binding UseFixedValueCommand}" Content="{loc:T QrContent.UseFixed}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                AutomationProperties.Name="{loc:T QrContent.UseFixed}">
          <Button.Visibility><Binding Path="ShowUseFixed" Converter="{StaticResource B2V}" /></Button.Visibility>
        </Button>

        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasHint, Converter={StaticResource B2V}}" />
        <Border Style="{StaticResource WarningBanner}" Margin="0,8,0,0" Padding="10,6" Visibility="{Binding HasNote, Converter={StaticResource B2V}}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12" MaxWidth="440" AutomationProperties.Name="{Binding Note}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding HasWarning, Converter={StaticResource B2V}}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasError, Converter={StaticResource B2V}}" />
      </StackPanel>
    </DataTemplate>

    <!-- The date picker's text box: the same quiet look as the other boxes, with the "Select a date" prompt centred. -->
    <Style TargetType="DatePickerTextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePickerTextBox">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WatermarkStates">
                  <VisualState x:Name="Unwatermarked" />
                  <VisualState x:Name="Watermarked">
                    <Storyboard>
                      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                      </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="12,0" />
              <ContentControl x:Name="PART_Watermark" IsHitTestVisible="False" Focusable="False" Foreground="{StaticResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"
                              Visibility="Collapsed" Content="{TemplateBinding Text}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DatePicker">
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <DataTemplate DataType="{x:Type vms:BuilderMessage}">
      <DockPanel Margin="0,0,0,6">
        <Border DockPanel.Dock="Left" Margin="0,2,8,0" VerticalAlignment="Top" Width="14" Height="14">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" />
        </Border>
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.Name="{Binding Text}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Common.Cancel}" />
          <Button Content="{loc:T QrContent.Apply}" Command="{Binding ApplyCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="140"
                  AutomationProperties.Name="{loc:T QrContent.Apply}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusHint}" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,24,0"
                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasStatusHint, Converter={StaticResource B2V}}" />
      </DockPanel>
    </Border>

    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <!-- ============================== left: the kind and the form -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{loc:T QrContent.KindHeading}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
          <ItemsControl ItemsSource="{Binding Kinds}" IsTabStop="False" AutomationProperties.Name="{loc:T QrContent.KindHeading}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="QrKinds" Style="{StaticResource BuilderChip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,18,20,4">
            <StackPanel>
              <TextBlock Text="{Binding KindName}" Style="{StaticResource SectionHeading}" Margin="0,0,0,16" AutomationProperties.HeadingLevel="Level2" />
              <ItemsControl ItemsSource="{Binding Editors}" IsTabStop="False" KeyboardNavigation.TabNavigation="Continue" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============================== right: preview, text, capacity, problems -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,4,0">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="{loc:T QrContent.Preview}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <Border Style="{StaticResource CodeFrame}" Height="212" HorizontalAlignment="Stretch">
                <Grid>
                  <Image Source="{Binding PreviewMatrix, Converter={StaticResource MatrixImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                         AutomationProperties.Name="{loc:T QrContent.Preview}" Visibility="{Binding HasPreview, Converter={StaticResource B2V}}" />
                  <TextBlock Text="{Binding PreviewHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="16,0"
                             Visibility="{Binding ShowPreviewHint, Converter={StaticResource B2V}}" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasPreviewNote, Converter={StaticResource B2V}}" />
              <TextBlock Text="{Binding SizeText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="{Binding SizeText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SizeIsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{loc:T QrContent.Capacity}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <ProgressBar Style="{StaticResource CapacityBar}" Value="{Binding CapacityPercent, Mode=OneWay}" AutomationProperties.Name="{loc:T QrContent.Capacity}"
                           AutomationProperties.HelpText="{Binding CapacityText}">
                <ProgressBar.Resources>
                  <Style TargetType="ProgressBar" BasedOn="{StaticResource CapacityBar}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CapacityIsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                      <DataTrigger Binding="{Binding CapacityIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Resources>
              </ProgressBar>
              <TextBlock Text="{Binding CapacityText}" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding CapacityText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CapacityIsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                      <DataTrigger Binding="{Binding CapacityIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding CapacityHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasCapacityHint, Converter={StaticResource B2V}}" />
              <TextBlock Text="{loc:T Prop.QrErrorCorrection}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
              <ComboBox ItemsSource="{Binding LevelChoices}" SelectedItem="{Binding SelectedLevel}" DisplayMemberPath="Display" AutomationProperties.Name="{loc:T Prop.QrErrorCorrection}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CharacterCount}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{loc:T QrContent.GeneratedText}" Style="{StaticResource SectionHeading}" Margin="0" AutomationProperties.HeadingLevel="Level2" />
              </DockPanel>
              <TextBox Text="{Binding GeneratedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource MonoTextBox}" MaxHeight="120" MinHeight="48" Margin="0,8,0,0"
                       VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontSize="12" AutomationProperties.Name="{loc:T QrContent.GeneratedText}"
                       AutomationProperties.HelpText="{Binding CharacterCount}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16,14,16,8" Margin="0,12,0,0" Visibility="{Binding HasMessages, Converter={StaticResource B2V}}"
                  AutomationProperties.Name="{loc:T QrContent.Problems}">
            <StackPanel>
              <TextBlock Text="{loc:T QrContent.Problems}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <ItemsControl ItemsSource="{Binding Messages}" IsTabStop="False" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</views:DialogWindow>
