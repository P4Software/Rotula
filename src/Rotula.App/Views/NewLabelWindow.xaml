<views:DialogWindow x:Class="Rotula.App.Views.NewLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        Title="{loc:T Dialog.New.Title}" Width="1120" Height="740" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Dialog.New.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />

    <!-- A row of the stock list: name, part number and brand, size in both units, print type, verified tag, star. -->
    <DataTemplate DataType="{x:Type vms:StockListItem}">
      <Grid AutomationProperties.Name="{Binding AutomationText}" Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding MediaText}" Style="{StaticResource MutedText}" FontSize="12" Margin="12,0,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsStock, Converter={StaticResource B2V}}">
          <Border Visibility="{Binding IsVerified, Converter={StaticResource B2V}}" ToolTip="{loc:T Stock.Verified}" Margin="0,0,6,0" VerticalAlignment="Center"
                  AutomationProperties.Name="{loc:T Stock.Verified}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Width="14" Height="14" TextElement.Foreground="{StaticResource SuccessBrush}" StrokeThickness="2" />
          </Border>
          <Border Visibility="{Binding IsUnverified, Converter={StaticResource B2V}}" ToolTip="{loc:T Stock.Unverified.Tip}" Margin="0,0,6,0" VerticalAlignment="Center"
                  Background="{StaticResource WarningTintBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
            <TextBlock Text="{loc:T Stock.Unverified}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
          </Border>
          <!-- The star is a mouse shortcut; the keyboard uses Ctrl+D (and the button in the detail pane), so Tab does not stop in every row. -->
          <Button Style="{StaticResource IconButton}" Width="30" Height="30" Focusable="False" IsTabStop="False"
                  Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding FavoriteName}" ToolTip="{Binding FavoriteName}">
            <Path Data="{StaticResource IconStar}" Width="16" Height="16" TextElement.Foreground="{StaticResource MutedBrush}">
              <Path.Style>
                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ToggleFavoriteCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:T Common.Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Common.Cancel}" />
          <Button Content="{loc:T Stock.CreateLabel}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="140" Click="OnCreate" AutomationProperties.Name="{loc:T Stock.CreateLabel}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock Text="{loc:T Stock.Disclaimer}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
          <Button Style="{StaticResource LinkButton}" Command="{Binding ShowAboutCommand}" Margin="0,2,0,0" AutomationProperties.Name="{loc:T Stock.About.Link}">
            <TextBlock Text="{loc:T Stock.About.Link}" FontSize="12" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="400" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- ============================== search and list -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:T Dialog.New.Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="40,0,12,0" TextChanged="OnSearchTextChanged"
                   PreviewKeyDown="OnSearchKeyDown" AutomationProperties.Name="{loc:T Stock.Search.Label}" AutomationProperties.HelpText="{Binding SearchHint}" ToolTip="{Binding SearchHint}" />
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Width="18" Height="18" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                TextElement.Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{loc:T Stock.Search.Placeholder}" Margin="41,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding SearchHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" />

        <!-- filters -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue">
          <ComboBox ItemsSource="{Binding BrandChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding BrandFilter}" MinWidth="140" Margin="0,0,8,8"
                    AutomationProperties.Name="{loc:T Stock.Filter.Brand}" ToolTip="{loc:T Stock.Filter.Brand}" />
          <ComboBox ItemsSource="{Binding FamilyChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FamilyFilter}" MinWidth="150" MaxWidth="220" Margin="0,0,8,8"
                    AutomationProperties.Name="{loc:T Stock.Filter.Family}" ToolTip="{loc:T Stock.Filter.Family}" />
          <ComboBox ItemsSource="{Binding UnitFilters}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding UnitFilter}" MinWidth="130" Margin="0,0,8,8"
                    AutomationProperties.Name="{loc:T Stock.Filter.Unit}" ToolTip="{loc:T Stock.Filter.Unit}" />
          <ComboBox ItemsSource="{Binding LayoutFilters}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding LayoutFilter}" MinWidth="120" Margin="0,0,8,8"
                    AutomationProperties.Name="{loc:T Stock.Filter.Layout}" ToolTip="{loc:T Stock.Filter.Layout}" />
          <CheckBox Content="{loc:T Stock.Filter.Verified}" IsChecked="{Binding VerifiedOnly}" Margin="4,0,12,8" VerticalAlignment="Center" AutomationProperties.Name="{loc:T Stock.Filter.Verified}" />
          <CheckBox Content="{loc:T Stock.Filter.Favorites}" IsChecked="{Binding FavoritesOnly}" Margin="0,0,0,8" VerticalAlignment="Center" AutomationProperties.Name="{loc:T Stock.Filter.Favorites}" />
        </WrapPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0,6" Margin="0,2,0,0">
          <Grid>
            <ListBox x:Name="StockList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="{loc:T Dialog.New.Search}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" MouseDoubleClick="OnListDoubleClick">
              <!-- The row is announced by screen readers with its full sentence (name, part number, size, print type, verified), not the class name. -->
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AutomationText}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="16,10,0,2" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
            </ListBox>
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource MutedText}" Margin="20" TextWrapping="Wrap" VerticalAlignment="Top"
                       Visibility="{Binding HasNoResults, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Command="{Binding ImportListCommand}" AutomationProperties.Name="{loc:T Stock.Import.Button}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}" Width="14" Height="14" Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Stock.Import.Button}" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Grid>

      <!-- ============================== detail -->
      <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="0,0,4,0">
          <StackPanel>
            <!-- a stock -->
            <StackPanel Visibility="{Binding ShowStockDetail, Converter={StaticResource B2V}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleFavoriteCommand}" VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding FavoriteToggleText}" ToolTip="{Binding FavoriteToggleText}">
                  <Path Data="{StaticResource IconStar}" TextElement.Foreground="{StaticResource MutedBrush}">
                    <Path.Style>
                      <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelectedFavorite}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                </Button>
                <StackPanel>
                  <TextBlock Text="{Binding StockTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="{Binding StockSubtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
              <Border Background="{StaticResource AccentTintBrush}" CornerRadius="8" Padding="16,12" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding StockSize}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" />
                  <TextBlock Text="{Binding StockSizeOther}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <!-- what applying this stock will warn about -->
              <Border Style="{StaticResource WarningBanner}" Margin="0,14,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Stock.Warnings.Heading}">
                <StackPanel>
                  <TextBlock Text="{loc:T Stock.Warnings.Heading}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,3,0,3">
                          <TextBlock DockPanel.Dock="Left" Text="&#x2022;" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- a continuous roll: the label length is the user's choice -->
              <StackPanel Visibility="{Binding NeedsHeight, Converter={StaticResource B2V}}" Margin="0,14,0,0">
                <TextBlock Text="{loc:T Stock.Height.Label}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ContinuousHeightUnit}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <TextBox Text="{Binding ContinuousHeightText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" AutomationProperties.Name="{loc:T Stock.Height.Label}" />
                </DockPanel>
              </StackPanel>

              <TextBlock Text="{loc:T Stock.Facts.Heading}" Style="{StaticResource SectionHeading}" Margin="0,18,0,8" />
              <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" Margin="0,0,16,0" FontSize="12.5" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- a common size or the custom size -->
            <StackPanel Visibility="{Binding ShowSizeFields, Converter={StaticResource B2V}}">
              <TextBlock Text="{loc:T Dialog.New.SizeHeading}" Style="{StaticResource SectionHeading}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Prop.LabelWidth}" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:T Prop.LabelHeight}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="WidthBox" Style="{StaticResource MonoTextBox}" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustom}"
                         AutomationProperties.Name="{loc:T Prop.LabelWidth}" />
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource MonoTextBox}" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustom}"
                         AutomationProperties.Name="{loc:T Prop.LabelHeight}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Prop.LabelUnit}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <ComboBox Grid.Row="3" Grid.Column="0" ItemsSource="{Binding Units}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Unit}"
                          IsEnabled="{Binding IsCustom}" AutomationProperties.Name="{loc:T Prop.LabelUnit}" />
              </Grid>

              <!-- keep this size as a stock of my own -->
              <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource B2V}}" Margin="0,18,0,0">
                <TextBlock Text="{loc:T Stock.Own.Heading}" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="{loc:T Stock.Own.Name}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding OwnName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Stock.Own.Name}" />
                <TextBlock Text="{loc:T Stock.Own.Part}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding OwnPart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Stock.Own.Part}" />
                <Button Content="{loc:T Stock.Own.Save}" Command="{Binding SaveOwnStockCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{loc:T Stock.Own.Save}" />
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </Border>
      </ScrollViewer>
      <!-- pinned under the details: the resolution decides the dots of the label, and messages must never be hidden by scrolling -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,4,0" Padding="20,14">
        <StackPanel>
          <TextBlock Text="{loc:T Prop.Dpi}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Dpis}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Dpi}" AutomationProperties.Name="{loc:T Prop.Dpi}" />
          <TextBlock Text="{Binding DpiNote}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
          <Border Style="{StaticResource SuccessBanner}" Margin="0,14,0,0" Visibility="{Binding HasStatus, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
          </Border>
          <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
      </Border>
      </Grid>
    </Grid>
  </DockPanel>
</views:DialogWindow>
