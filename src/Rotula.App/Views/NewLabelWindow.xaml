<Window x:Class="Rotula.App.Views.NewLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        Title="{loc:T Dialog.New.Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Dialog.New.Title}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{loc:T Dialog.New.Preset}" Margin="0,0,0,4" />
    <ComboBox Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
              DisplayMemberPath="Name" AutomationProperties.Name="{loc:T Dialog.New.Preset}" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Prop.LabelWidth}" Margin="0,12,0,4" />
    <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:T Prop.LabelHeight}" Margin="0,12,0,4" />
    <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustom}"
             AutomationProperties.Name="{loc:T Prop.LabelWidth}" />
    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustom}"
             AutomationProperties.Name="{loc:T Prop.LabelHeight}" />

    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
      <TextBlock Text="{loc:T Prop.LabelUnit}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" IsEnabled="{Binding IsCustom}" MinWidth="110" Margin="0,0,16,0"
                AutomationProperties.Name="{loc:T Prop.LabelUnit}" />
      <TextBlock Text="{loc:T Prop.Dpi}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding Dpis}" SelectedItem="{Binding Dpi}" MinWidth="90" AutomationProperties.Name="{loc:T Prop.Dpi}" />
    </StackPanel>

    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,16,0,0">
      <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="{loc:T Common.Create}" IsDefault="True" MinWidth="88" Padding="8,3" Margin="0,0,8,0" Click="OnCreate"
                AutomationProperties.Name="{loc:T Common.Create}" />
        <Button Content="{loc:T Common.Cancel}" IsCancel="True" MinWidth="88" Padding="8,3" AutomationProperties.Name="{loc:T Common.Cancel}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
