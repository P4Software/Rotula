<views:DialogWindow x:Class="Rotula.App.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Rotula.App.Controls"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{loc:T Print.Title}" Width="660" Height="800" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Print.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
  </Window.Resources>
  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:T Common.Close}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" Command="{Binding CloseCommand}"
                  AutomationProperties.Name="{loc:T Common.Close}" />
          <Button Content="{loc:T Print.Button.Print}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Command="{Binding PrintCommand}"
                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:T Print.Button.Print}" />
        </StackPanel>
        <!-- A WrapPanel: in Spanish the two secondary buttons are long, and in a narrow window they drop to a second line instead of overlapping Close/Print. -->
        <WrapPanel IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Content="{loc:T Print.Button.SaveZpl}" Command="{Binding SaveZplCommand}" Margin="0,2,8,2" AutomationProperties.Name="{loc:T Print.Button.SaveZpl}" />
          <Button Content="{loc:T Print.Button.Test}" Command="{Binding PrintTestCommand}" Margin="0,2,0,2" AutomationProperties.Name="{loc:T Print.Button.Test}"
                  ToolTip="{loc:T Print.Button.Test.Tip}" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- ============================== busy + result -->
    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,16">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{loc:T Common.StopOperation}" Command="{Binding CancelOperationCommand}" MinHeight="30" Margin="12,0,0,0"
                  AutomationProperties.Name="{loc:T Common.StopOperation}" />
          <StackPanel>
            <TextBlock Text="{Binding BusyText}" Margin="0,0,0,6" />
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{Binding BusyText}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive">
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
      </Border>
      <Border Style="{StaticResource SuccessBanner}" Visibility="{Binding HasSuccess, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
      </Border>
    </StackPanel>

    <!-- ============================== content -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24,20,24,16" IsEnabled="{Binding IsIdle}">
        <TextBlock Text="{loc:T Print.Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{loc:T Print.Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,16" />

        <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,16" Visibility="{Binding HasLabelProblems, Converter={StaticResource B2V}}">
          <StackPanel>
            <TextBlock Text="{loc:T Print.LabelHasErrors}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LabelProblems}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,16" Visibility="{Binding UsesRecordData, Converter={StaticResource B2V}}">
          <TextBlock Text="{loc:T Print.UsesRecord}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
          <views:PrinterSettingsView DataContext="{Binding Printer}" />
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="{loc:T Print.Copies}" Style="{StaticResource FieldLabel}" />
            <TextBox Style="{StaticResource MonoTextBox}" Width="140" HorizontalAlignment="Left" Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{loc:T Print.Copies}"  ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=int:1:99999999}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</views:DialogWindow>
