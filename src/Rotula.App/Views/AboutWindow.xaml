<views:DialogWindow x:Class="Rotula.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{loc:T About.Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T About.Title}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:T Common.Close}" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="96"
                AutomationProperties.Name="{loc:T Common.Close}" Click="OnClose" />
        <Button Content="{loc:T About.Notices}" HorizontalAlignment="Left" MinWidth="96" Click="OnNotices" AutomationProperties.Name="{loc:T About.Notices}" />
      </DockPanel>
    </Border>
    <StackPanel Margin="32,28,32,24">
      <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource BrandMark}" Width="96" Height="96" UseLayoutRounding="True" AutomationProperties.Name="Rotula" />
        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Rotula" FontSize="26" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{loc:T About.Tagline}" TextWrapping="Wrap" FontSize="14" Margin="0,20,0,0" />
      <TextBlock Text="{loc:T About.Privacy}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
      <Button Style="{StaticResource LinkButton}" Margin="0,12,0,0" Click="OnLink" ToolTip="{loc:T About.Link.Tip}" AutomationProperties.Name="{loc:T About.Link}"
              AutomationProperties.HelpText="{loc:T About.Link.Tip}" Content="{loc:T About.Link}" />
      <Border Style="{StaticResource InfoBanner}" Margin="0,20,0,0">
        <TextBlock Text="{loc:T About.Approximate}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
      </Border>
    </StackPanel>
  </DockPanel>
</views:DialogWindow>
