<views:DialogWindow x:Class="Rotula.App.Views.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Rotula.App.Controls"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{loc:T Conn.Title}" Width="940" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Conn.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
  </Window.Resources>

  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:T Common.Close}" IsCancel="True" MinWidth="88" Command="{Binding CloseCommand}" AutomationProperties.Name="{loc:T Common.Close}" />
      </DockPanel>
    </Border>

    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ============================== list -->
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Conn.Saved.Heading}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Command="{Binding NewConnectionCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Conn.New}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Width="14" Height="14" Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Conn.New}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:T Conn.Delete}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" Width="14" Height="14" Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Conn.Delete}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="0,8">
          <Grid>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="{loc:T Conn.Saved.Heading}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProviderName}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{loc:T Conn.Saved.None}" Style="{StaticResource MutedText}" Margin="16" VerticalAlignment="Top" TextWrapping="Wrap"
                       Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}" />
          </Grid>
        </Border>
      </DockPanel>

      <!-- ============================== form -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="0,0,4,0">
          <StackPanel>
            <TextBlock Text="{loc:T Conn.Form.Heading}" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,16">
              <TextBlock Text="{loc:T Conn.ReadOnlyNote}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{loc:T Conn.Name}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditName}" AutomationProperties.Name="{loc:T Conn.Name}" />
            <TextBlock Text="{loc:T Conn.Name.Fixed}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding CanEditName}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{loc:T Conn.Name.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding CanEditName, Converter={StaticResource B2V}}" />

            <TextBlock Text="{loc:T Conn.Provider}" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
            <ComboBox ItemsSource="{Binding ProviderChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Provider}"
                      AutomationProperties.Name="{loc:T Conn.Provider}" />

            <!-- server engines -->
            <StackPanel Visibility="{Binding IsServer, Converter={StaticResource B2V}}">
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{loc:T Conn.Host}" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Conn.Host}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{loc:T Conn.Port}" Style="{StaticResource FieldLabel}" />
                  <Grid>
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" AutomationProperties.Name="{loc:T Conn.Port}"
                             ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=int:1:65535:opt}" />
                    <TextBlock Text="{Binding PortHint}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="13,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding PortText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Grid>
              <TextBlock Text="{loc:T Conn.Database}" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
              <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Conn.Database}" />
            </StackPanel>

            <!-- SQLite file -->
            <StackPanel Visibility="{Binding IsSqlite, Converter={StaticResource B2V}}" Margin="0,16,0,0">
              <TextBlock Text="{loc:T Conn.Sqlite.File}" Style="{StaticResource FieldLabel}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T Conn.Browse}" Command="{Binding BrowseFileCommand}" Margin="8,0,0,0" MinHeight="40" AutomationProperties.Name="{loc:T Conn.Browse}" />
                <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" AutomationProperties.Name="{loc:T Conn.Sqlite.File}" />
              </DockPanel>
              <TextBlock Text="{loc:T Conn.Sqlite.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <!-- ODBC -->
            <StackPanel Visibility="{Binding IsOdbc, Converter={StaticResource B2V}}" Margin="0,16,0,0">
              <TextBlock Text="{loc:T Conn.Odbc.Dsn}" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Dsn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Conn.Odbc.Dsn}" />
              <TextBlock Text="{loc:T Conn.Odbc.String}" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
              <TextBox Text="{Binding OdbcConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" AutomationProperties.Name="{loc:T Conn.Odbc.String}" />
              <TextBlock Text="{loc:T Conn.Odbc.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- sign-in -->
            <StackPanel Visibility="{Binding ShowAuth, Converter={StaticResource B2V}}" Margin="0,16,0,0">
              <StackPanel Visibility="{Binding CanWindowsAuth, Converter={StaticResource B2V}}">
                <TextBlock Text="{loc:T Conn.Auth}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AuthChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Authentication}"
                          AutomationProperties.Name="{loc:T Conn.Auth}" />
              </StackPanel>
              <Grid Margin="0,12,0,0" Visibility="{Binding ShowUserFields, Converter={StaticResource B2V}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{loc:T Conn.User}" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Conn.User}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{loc:T Conn.Password}" Style="{StaticResource FieldLabel}" />
                  <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="{loc:T Conn.Password}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                         Visibility="{Binding ShowUserFields, Converter={StaticResource B2V}}" />
            </StackPanel>

            <!-- security: the warning is shown before the box is switched, and turns amber while the risky choice is on -->
            <StackPanel Visibility="{Binding IsServer, Converter={StaticResource B2V}}" Margin="0,20,0,0">
              <TextBlock Text="{loc:T Conn.Security}" Style="{StaticResource SectionHeading}" />
              <CheckBox Content="{loc:T Conn.Encrypt}" IsChecked="{Binding Encrypt}" AutomationProperties.Name="{loc:T Conn.Encrypt}" />
              <TextBlock Text="{loc:T Conn.Encrypt.Warning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="26,2,0,0" />
              <Border Style="{StaticResource WarningBanner}" Margin="26,6,0,0" Visibility="{Binding ShowEncryptWarning, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
                <DockPanel>
                  <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                  <TextBlock Text="{loc:T Conn.Encrypt.Off}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                </DockPanel>
              </Border>
              <CheckBox Content="{loc:T Conn.Trust}" IsChecked="{Binding TrustServerCertificate}" Margin="0,12,0,0" AutomationProperties.Name="{loc:T Conn.Trust}" />
              <TextBlock Text="{loc:T Conn.Trust.Warning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="26,2,0,0" />
              <Border Style="{StaticResource WarningBanner}" Margin="26,6,0,0" Visibility="{Binding ShowTrustWarning, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
                <DockPanel>
                  <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                  <TextBlock Text="{loc:T Conn.Trust.On}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                </DockPanel>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding FormError}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasFormError, Converter={StaticResource B2V}}"
                       AutomationProperties.LiveSetting="Assertive" />

            <!-- actions -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button Content="{loc:T Conn.Test}" Command="{Binding TestCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Conn.Test}" />
              <Button Content="{loc:T Conn.Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Conn.Save}" />
              <Button Content="{loc:T Common.StopOperation}" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" AutomationProperties.Name="{loc:T Common.StopOperation}" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
              <TextBlock Text="{Binding BusyText}" Margin="0,0,0,6" />
              <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{Binding BusyText}" />
            </StackPanel>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,12,0,0" Visibility="{Binding HasTestError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive">
              <StackPanel>
                <TextBlock Text="{Binding TestText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                <TextBlock Text="{Binding TestDetail}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                           Visibility="{Binding HasTestDetail, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Data.Db.ErrorDetail}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SuccessBanner}" Margin="0,12,0,0" Visibility="{Binding HasTestSuccess, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
              <TextBlock Text="{Binding TestText}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
            </Border>
            <!-- certificate failure: offer to trust this server (explicitly, and saved with the connection) -->
            <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="{Binding ShowTrustOffer, Converter={StaticResource B2V}}">
              <StackPanel>
                <TextBlock Text="{loc:T Conn.TrustOffer}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                <Button Content="{loc:T Conn.TrustOffer.Button}" Command="{Binding TrustAndSaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        AutomationProperties.Name="{loc:T Conn.TrustOffer.Button}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</views:DialogWindow>
