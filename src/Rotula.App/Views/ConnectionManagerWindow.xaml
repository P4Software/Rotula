<views:DialogWindow x:Class="Rotula.App.Views.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Rotula.App.Controls"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        Title="{loc:T Conn.Title}" Width="940" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Conn.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />

    <!-- One form field, drawn from the option schema of the provider: text, number, host, path with Browse, choice or switch. -->
    <DataTemplate DataType="{x:Type vms:OptionFieldViewModel}">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Visibility="{Binding ShowLabel, Converter={StaticResource B2V}}" />
        <Grid Visibility="{Binding IsTextLike, Converter={StaticResource B2V}}">
          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMono}" Value="True"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
          <TextBlock Text="{Binding Placeholder}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Style="{StaticResource MutedText}" Visibility="{Binding ShowPlaceholder, Converter={StaticResource B2V}}" />
        </Grid>
        <DockPanel Visibility="{Binding IsPath, Converter={StaticResource B2V}}">
          <Button DockPanel.Dock="Right" Content="{loc:T Conn.Browse}" Click="OnBrowseField" Margin="8,0,0,0" MinHeight="40" AutomationProperties.Name="{loc:T Conn.Browse}"
                  Visibility="{Binding CanBrowse, Converter={StaticResource B2V}}" />
          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" AutomationProperties.Name="{Binding Label}" />
        </DockPanel>
        <!-- an editable drop-down: type a name, or pick one loaded from the server (databases) or this computer (ODBC data sources) -->
        <StackPanel Visibility="{Binding HasLookup, Converter={StaticResource B2V}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:T Common.StopOperation}" Command="{Binding StopListCommand}" Margin="8,0,0,0" MinHeight="40" MinWidth="96"
                    Visibility="{Binding IsLoadingList, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Common.StopOperation}" />
            <Button DockPanel.Dock="Right" Content="{loc:T Conn.Db.LoadList}" Command="{Binding LoadListCommand}" Margin="8,0,0,0" MinHeight="40" MinWidth="96"
                    Visibility="{Binding IsNotLoadingList, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Conn.Db.LoadList}" />
            <ComboBox IsEditable="True" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding LookupItems}" TextSearch.TextPath="Name"
                      MaxDropDownHeight="300" DropDownOpened="OnLookupDropDownOpened" AutomationProperties.Name="{Binding Label}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="24,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding IsLoadingList, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Conn.Db.Loading}" />
          <TextBlock Text="{Binding LookupText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding HasLookupText, Converter={StaticResource B2V}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Style.Triggers><DataTrigger Binding="{Binding LookupIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <ComboBox Visibility="{Binding IsChoice, Converter={StaticResource B2V}}" ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedChoice}" AutomationProperties.Name="{Binding Label}" />
        <CheckBox Visibility="{Binding IsBool, Converter={StaticResource B2V}}" Content="{Binding Label}" IsChecked="{Binding Flag}" AutomationProperties.Name="{Binding Label}" />
        <TextBlock Text="{Binding Help}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasHelp, Converter={StaticResource B2V}}" />
        <TextBlock Text="{Binding PatternHelp}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasPatternHelp, Converter={StaticResource B2V}}" />
        <TextBlock Text="{Binding Help}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="26,2,0,0" Visibility="{Binding HasSwitchHelp, Converter={StaticResource B2V}}" />
        <Border Style="{StaticResource WarningBanner}" Margin="26,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
          </DockPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="{loc:T Common.Close}" IsCancel="True" MinWidth="88" Command="{Binding CloseCommand}" AutomationProperties.Name="{loc:T Common.Close}" />
      </DockPanel>
    </Border>

    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ============================== list -->
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Conn.Saved.Heading}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Command="{Binding NewConnectionCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Conn.New}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Width="14" Height="14" Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Conn.New}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:T Conn.Delete}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" Width="14" Height="14" Margin="0,0,6,0" />
              <TextBlock Text="{loc:T Conn.Delete}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="0,8">
          <Grid>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="{loc:T Conn.Saved.Heading}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProviderName}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{loc:T Conn.Saved.None}" Style="{StaticResource MutedText}" Margin="16" VerticalAlignment="Top" TextWrapping="Wrap"
                       Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}" />
          </Grid>
        </Border>
      </DockPanel>

      <!-- ============================== form -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource Card}" Margin="0,0,4,0">
          <StackPanel>
            <TextBlock Text="{loc:T Conn.Form.Heading}" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,16">
              <TextBlock Text="{loc:T Conn.ReadOnlyNote}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{loc:T Conn.Name}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditName}" AutomationProperties.Name="{loc:T Conn.Name}" />
            <TextBlock Text="{loc:T Conn.Name.Fixed}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding CanEditName}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{loc:T Conn.Name.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding CanEditName, Converter={StaticResource B2V}}" />

            <TextBlock Text="{loc:T Conn.Provider}" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
            <ComboBox x:Name="EngineBox" ItemsSource="{Binding EngineView}" SelectedItem="{Binding SelectedEngine}" DisplayMemberPath="Name" MaxDropDownHeight="420"
                      AutomationProperties.Name="{loc:T Conn.Provider}">
              <ComboBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="8,8,0,2" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ComboBox.GroupStyle>
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                  <Style.Triggers>
                    <!-- Presets sit under their provider, indented. -->
                    <DataTrigger Binding="{Binding IsPreset}" Value="True"><Setter Property="Padding" Value="28,6,12,6" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>

            <!-- the address looks like a known service: offer its settings -->
            <Border Style="{StaticResource InfoBanner}" Margin="0,8,0,0" Visibility="{Binding HasDetectedPreset, Converter={StaticResource B2V}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T Conn.Preset.UseDetected}" Command="{Binding UseDetectedPresetCommand}" Margin="12,0,0,0" AutomationProperties.Name="{loc:T Conn.Preset.UseDetected}" />
                <TextBlock Text="{Binding DetectedPresetText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <!-- a saved connection of an add-on that is not installed -->
            <Border Style="{StaticResource WarningBanner}" Margin="0,16,0,0" Visibility="{Binding IsPackMissing, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
              <DockPanel>
                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding MissingPackText}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
              </DockPanel>
            </Border>

            <StackPanel Visibility="{Binding IsFormAvailable, Converter={StaticResource B2V}}">
              <!-- the fields of the chosen engine, drawn from its option schema -->
              <ItemsControl ItemsSource="{Binding Fields}" Margin="0,16,0,0" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:OptionFieldPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- sign-in -->
              <StackPanel Visibility="{Binding ShowAuth, Converter={StaticResource B2V}}">
                <StackPanel Visibility="{Binding ShowAuthChoice, Converter={StaticResource B2V}}" Margin="0,4,0,0">
                  <TextBlock Text="{loc:T Conn.Auth}" Style="{StaticResource FieldLabel}" />
                  <ComboBox ItemsSource="{Binding AuthChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Authentication}"
                            AutomationProperties.Name="{loc:T Conn.Auth}" />
                </StackPanel>
                <Grid Margin="0,12,0,0" Visibility="{Binding ShowUserFields, Converter={StaticResource B2V}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{loc:T Conn.User}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Conn.User}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:T Conn.Password}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="{loc:T Conn.Password}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ShowUserFields, Converter={StaticResource B2V}}" />
              </StackPanel>

              <!-- security switches: the warning stays visible while the risky choice is on -->
              <StackPanel Visibility="{Binding HasSwitchFields, Converter={StaticResource B2V}}" Margin="0,20,0,0">
                <TextBlock Text="{loc:T Conn.Security}" Style="{StaticResource SectionHeading}" />
                <ItemsControl ItemsSource="{Binding SwitchFields}" Focusable="False" KeyboardNavigation.TabNavigation="Continue" />
              </StackPanel>

              <Expander Header="{loc:T Conn.Advanced}" Margin="0,12,0,0" Visibility="{Binding HasAdvancedFields, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Conn.Advanced}">
                <ItemsControl ItemsSource="{Binding AdvancedFields}" Margin="0,12,0,0" Focusable="False" KeyboardNavigation.TabNavigation="Continue" />
              </Expander>

              <!-- hints of the preset and read-only advice -->
              <ItemsControl ItemsSource="{Binding Hints}" Margin="0,16,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" AutomationProperties.Name="{Binding Text}">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource InfoBanner}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                              <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                              <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding FormError}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasFormError, Converter={StaticResource B2V}}"
                       AutomationProperties.LiveSetting="Assertive" />

            <!-- actions -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button Content="{loc:T Conn.Test}" Command="{Binding TestCommand}" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Conn.Test}" />
              <Button Content="{loc:T Conn.Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Conn.Save}" />
              <Button Content="{loc:T Common.StopOperation}" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" AutomationProperties.Name="{loc:T Common.StopOperation}" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
              <TextBlock Text="{Binding BusyText}" Margin="0,0,0,6" />
              <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{Binding BusyText}" />
            </StackPanel>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,12,0,0" Visibility="{Binding HasTestError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive">
              <StackPanel>
                <TextBlock Text="{Binding TestText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                <TextBlock Text="{Binding TestDetail}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                           Visibility="{Binding HasTestDetail, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Data.Db.ErrorDetail}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SuccessBanner}" Margin="0,12,0,0" Visibility="{Binding HasTestSuccess, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
              <TextBlock Text="{Binding TestText}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
            </Border>
            <!-- certificate failure: offer to trust this server (explicitly, and saved with the connection) -->
            <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="{Binding ShowTrustOffer, Converter={StaticResource B2V}}">
              <StackPanel>
                <TextBlock Text="{loc:T Conn.TrustOffer}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                <Button Content="{loc:T Conn.TrustOffer.Button}" Command="{Binding TrustAndSaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        AutomationProperties.Name="{loc:T Conn.TrustOffer.Button}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</views:DialogWindow>
