<views:DialogWindow x:Class="Rotula.App.Views.PromptDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        Title="{loc:T Prompt.Title}" Width="520" SizeToContent="Height" MaxHeight="720" MinWidth="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Prompt.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />

    <!-- One question: caption, the input (text box or list of choices), optional help and the reason an answer was refused. -->
    <DataTemplate DataType="{x:Type vms:PromptFieldViewModel}">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="{Binding Caption}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="Answer" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"
                 AutomationProperties.Name="{Binding Caption}" AutomationProperties.HelpText="{Binding Help}">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Caption}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>
        <TextBlock Text="{Binding Help}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasHelp, Converter={StaticResource B2V}}" />
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:T Common.Cancel}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                AutomationProperties.Name="{loc:T Common.Cancel}" />
        <Button Content="{loc:T Prompt.Button.Continue}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Command="{Binding AcceptCommand}"
                AutomationProperties.Name="{loc:T Prompt.Button.Continue}" />
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24,20,24,8">
        <TextBlock Text="{loc:T Prompt.Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{loc:T Prompt.Subtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,16" />
        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</views:DialogWindow>
