<views:DialogWindow x:Class="Rotula.App.Views.Gs1BuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        xmlns:ctl="clr-namespace:Rotula.App.Controls"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        Title="{Binding Title}" Width="1240" Height="780" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{Binding Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
    <views:MatrixImageConverter x:Key="MatrixImage" />

    <!-- An identifier in the picker. -->
    <DataTemplate DataType="{x:Type vms:Gs1AiItem}">
      <Grid Margin="0,4" AutomationProperties.Name="{Binding Display}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Ai}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
        <TextBlock Grid.Column="2" Text="{Binding Format}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- A chosen identifier with the field for its value. -->
    <DataTemplate DataType="{x:Type vms:Gs1Segment}">
      <Border Style="{StaticResource Card}" Padding="16,12,16,12" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding MoveUpCommand}" ToolTip="{loc:T Gs1Builder.MoveUp}" AutomationProperties.Name="{loc:T Gs1Builder.MoveUp}">
                <Path Style="{StaticResource Icon}" Data="M2,8 L6,4 L10,8" Width="12" Height="12" />
              </Button>
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding MoveDownCommand}" ToolTip="{loc:T Gs1Builder.MoveDown}" AutomationProperties.Name="{loc:T Gs1Builder.MoveDown}">
                <Path Style="{StaticResource Icon}" Data="M2,4 L6,8 L10,4" Width="12" Height="12" />
              </Button>
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding RemoveCommand}" ToolTip="{loc:T Gs1Builder.Remove}" AutomationProperties.Name="{loc:T Gs1Builder.Remove}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" Width="11" Height="11" />
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3" />
          </DockPanel>
          <DockPanel Margin="0,0,0,4">
            <views:FieldPickerButton DockPanel.Dock="Right" Caption="{loc:T Fields.Insert}" Row="{Binding Value.Row}" Status="{Binding Value.Label}" Target="{Binding ElementName=Box}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:T Gs1Builder.ValueLabel}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox x:Name="Box" Text="{Binding Value.Row.Text, UpdateSourceTrigger=PropertyChanged}" IsUndoEnabled="False" Style="{StaticResource MonoTextBox}"
                   ctl:FieldBox.Row="{Binding Value.Row}" ctl:FieldState.HasError="{Binding Value.HasError}"
                   AutomationProperties.Name="{Binding Value.Label}" AutomationProperties.HelpText="{Binding Value.Hint}" />
          <TextBlock Text="{Binding Value.Hint}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding Value.HasHint, Converter={StaticResource B2V}}" />
          <TextBlock Text="{Binding Value.Warning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding Value.HasWarning, Converter={StaticResource B2V}}" />
          <TextBlock Text="{Binding Value.Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Value.HasError, Converter={StaticResource B2V}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vms:BuilderMessage}">
      <DockPanel Margin="0,0,0,6">
        <Border DockPanel.Dock="Left" Margin="0,2,8,0" VerticalAlignment="Top" Width="14" Height="14">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" />
        </Border>
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.Name="{Binding Text}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Common.Cancel}" />
          <Button Content="{loc:T Gs1Builder.Apply}" Command="{Binding ApplyCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="140"
                  AutomationProperties.Name="{loc:T Gs1Builder.Apply}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusHint}" Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,24,0"
                   AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasStatusHint, Converter={StaticResource B2V}}" />
      </DockPanel>
    </Border>

    <Grid Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <!-- ============================== left: presets and the identifier picker -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Gs1Builder.PresetHeading}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Presets}" IsTabStop="False" Margin="0,0,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,0,8"
                      HorizontalContentAlignment="Left" Padding="12,8" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}">
                <!-- The button template centres its content, so the text block gets the width of the column and its own left alignment. -->
                <StackPanel HorizontalAlignment="Left" Width="276">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Left" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Left" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock DockPanel.Dock="Top" Text="{loc:T Gs1Builder.PickerHeading}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
        <Grid DockPanel.Dock="Top">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" PreviewKeyDown="OnSearchKeyDown"
                   AutomationProperties.Name="{loc:T Gs1Builder.Search}" ToolTip="{loc:T Gs1Builder.Search.Tip}" />
          <!-- A prompt inside the empty box; it never takes the mouse or the keyboard. -->
          <TextBlock Text="{loc:T Gs1Builder.Search}" Foreground="{StaticResource DisabledTextBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultsText}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,6,0,6" AutomationProperties.LiveSetting="Polite" />
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:T Gs1Builder.PickerKeys}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
        <ListBox x:Name="Results" ItemsSource="{Binding Results}" MouseDoubleClick="OnResultsDoubleClick" PreviewKeyDown="OnResultsKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:T Gs1Builder.Results}" />
      </DockPanel>

      <!-- ============================== middle: the chosen identifiers -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="{loc:T Gs1Builder.SegmentsHeading}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
          <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,12" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}">
            <TextBlock Text="{loc:T Gs1Builder.Empty}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Segments}" IsTabStop="False" KeyboardNavigation.TabNavigation="Continue" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============================== right: result -->
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,4,0">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="{loc:T Gs1Builder.Preview}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <Border Style="{StaticResource CodeFrame}" Height="150">
                <Grid>
                  <Image Source="{Binding PreviewMatrix, Converter={StaticResource MatrixImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                         AutomationProperties.Name="{loc:T Gs1Builder.Preview}" Visibility="{Binding HasPreview, Converter={StaticResource B2V}}" />
                  <TextBlock Text="{loc:T Gs1Builder.Preview.Waiting}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
              <TextBlock Text="{Binding HumanReadable}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                         AutomationProperties.Name="{Binding HumanReadable}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{loc:T Gs1Builder.Readable}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <TextBox Text="{Binding Template, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource MonoTextBox}" MinHeight="40" FontSize="12"
                       AutomationProperties.Name="{loc:T Gs1Builder.Readable}" />
              <TextBlock Text="{loc:T Gs1Builder.Fnc1Heading}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
              <TextBox Text="{Binding Fnc1Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource MonoTextBox}" MinHeight="40" FontSize="12"
                       AutomationProperties.Name="{loc:T Gs1Builder.Fnc1Heading}" AutomationProperties.HelpText="{loc:T Gs1Builder.Fnc1Help}" ToolTip="{loc:T Gs1Builder.Fnc1Help}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{loc:T Gs1Builder.CounterHeading}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{Binding CounterText}" FontSize="13" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding CounterText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Style.Triggers><DataTrigger Binding="{Binding CounterIsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="16,14,16,8" Margin="0,12,0,0" Visibility="{Binding HasMessages, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T QrContent.Problems}">
            <StackPanel>
              <TextBlock Text="{loc:T QrContent.Problems}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
              <ItemsControl ItemsSource="{Binding Messages}" IsTabStop="False" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</views:DialogWindow>
