<views:DialogWindow x:Class="Rotula.App.Views.StationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        xmlns:vms="clr-namespace:Rotula.App.ViewModels"
        Title="{loc:T Station.Setup.Title}" Width="760" Height="780" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Station.Setup.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />

    <!-- One label of the station: name, printer and mode, what the station does with it, and the findings with the one box. -->
    <DataTemplate DataType="{x:Type vms:StationSetupLabelViewModel}">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Name}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{Binding PrinterText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Visibility="{Binding HasPrinterText, Converter={StaticResource B2V}}" />
          <TextBlock Text="{Binding ModeText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Visibility="{Binding HasModeText, Converter={StaticResource B2V}}" />
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasStatusText, Converter={StaticResource B2V}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- The findings, worded as in the Print dialog. The box is hidden when a finding is an error: nothing lets such a label through. -->
          <Border x:Name="FindingsCard" Style="{StaticResource WarningBanner}" Margin="0,10,0,0" Visibility="{Binding HasFindingLines, Converter={StaticResource B2V}}"
                  AutomationProperties.Name="{loc:T Station.Driver.SetupFindings}">
            <StackPanel>
              <TextBlock Text="{loc:T Station.Driver.SetupFindings}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                         AutomationProperties.HeadingLevel="Level3" />
              <ItemsControl ItemsSource="{Binding FindingLines}" Margin="0,6,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" Foreground="{StaticResource WarningBrush}" />
                      <TextBlock x:Name="FindingLine" Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox x:Name="AcknowledgeBox" IsChecked="{Binding Acknowledged}" Margin="0,4,0,0"
                        Visibility="{Binding NeedsAcknowledgement, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Station.Setup.Acknowledge}">
                <TextBlock Text="{loc:T Station.Setup.Acknowledge}" TextWrapping="Wrap" />
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <!-- ============================== footer -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:T Common.Close}" IsCancel="True" MinWidth="88" Margin="0,0,8,0" Click="OnClose" AutomationProperties.Name="{loc:T Common.Close}" />
          <Button Content="{loc:T Station.Setup.Save}" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:T Station.Setup.Save}" />
        </StackPanel>
        <WrapPanel IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Content="{loc:T Station.Setup.Check}" Command="{Binding CheckCommand}" Margin="0,2,8,2" AutomationProperties.Name="{loc:T Station.Setup.Check}" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- ============================== busy + result -->
    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,16">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{loc:T Common.StopOperation}" Command="{Binding CancelOperationCommand}" MinHeight="30" Margin="12,0,0,0"
                  AutomationProperties.Name="{loc:T Common.StopOperation}" />
          <StackPanel>
            <TextBlock Text="{Binding BusyText}" Margin="0,0,0,6" />
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{Binding BusyText}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive">
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
      </Border>
      <Border Style="{StaticResource SuccessBanner}" Visibility="{Binding HasSuccess, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
      </Border>
    </StackPanel>

    <!-- ============================== content -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="24,20,24,16" IsEnabled="{Binding IsIdle}">
        <TextBlock Text="{loc:T Station.Setup.Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{loc:T Station.Setup.Intro}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8" />
        <TextBlock Text="{Binding StationText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <ItemsControl ItemsSource="{Binding Labels}" Focusable="False" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</views:DialogWindow>
