<views:DialogWindow x:Class="Rotula.App.Views.PackTrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{loc:T Data.Pack.Trust.Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Data.Pack.Trust.Title}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- Skip is the safe default: Enter and Esc both leave the add-on switched off. -->
        <Button x:Name="SkipButton" Content="{loc:T Pack.Trust.Skip}" IsDefault="True" IsCancel="True" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Pack.Trust.Skip}" />
        <Button Content="{loc:T Pack.Trust.Approve}" Style="{StaticResource PrimaryButton}" MinWidth="140" Click="OnApprove" AutomationProperties.Name="{loc:T Pack.Trust.Approve}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,20,24,16">
      <TextBlock Text="{loc:T Data.Pack.Trust.Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
      <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,16">
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:T Pack.Trust.Publisher}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
        <TextBlock x:Name="PublisherText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="{loc:T Pack.Trust.Version}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
        <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
        <TextBlock Grid.Row="2" Text="{loc:T Pack.Trust.Fingerprint}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
        <TextBlock x:Name="FingerprintText" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="3" Text="{loc:T Pack.Trust.Folder}" Style="{StaticResource FieldLabel}" />
        <TextBlock x:Name="FolderText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" />
      </Grid>
      <TextBlock Text="{loc:T Pack.Trust.SkipNote}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0" />
    </StackPanel>
  </DockPanel>
</views:DialogWindow>
