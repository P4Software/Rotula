<views:DialogWindow x:Class="Rotula.App.Views.PackDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Rotula.App.Localization"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Title="{loc:T Pack.Details.Title}" Width="660" Height="540" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:T Pack.Details.Title}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <Button Content="{loc:T Common.Close}" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="96" HorizontalAlignment="Right"
              AutomationProperties.Name="{loc:T Common.Close}" Click="OnClose" />
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24,20,24,16">
        <TextBlock Text="{loc:T Pack.Details.Title}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{loc:T Pack.Details.Intro}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,16" />
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <ItemsControl ItemsSource="{Binding Items}" KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{loc:T Pack.Details.Review}" Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" Visibility="{Binding CanReview, Converter={StaticResource B2V}}" VerticalAlignment="Top" Margin="12,0,0,0"
                          AutomationProperties.Name="{Binding ReviewName}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <Expander Header="{loc:T Pack.Details.Technical}" Margin="0,6,0,0" Visibility="{Binding HasDetail, Converter={StaticResource B2V}}">
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </Expander>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</views:DialogWindow>
