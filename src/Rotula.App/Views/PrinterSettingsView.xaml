<UserControl x:Class="Rotula.App.Views.PrinterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rotula.App.Controls"
             xmlns:loc="clr-namespace:Rotula.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
  </UserControl.Resources>
  <StackPanel>
    <!-- Informative note, not a warning: the label is converted to the printer resolution automatically. It sits at the very top so the note and its button are always in view, however long the form below is. -->
    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,16" Visibility="{Binding HasDpiMismatch, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
      <StackPanel>
        <TextBlock Text="{Binding DpiMismatchText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding DpiMismatchText}" />
        <!-- The action sits right under the note, before the (variable length) list of details, so it never ends up below the fold. -->
        <Button Content="{Binding SwitchLabelDpiText}" Command="{Binding SwitchLabelDpiCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource ToolButton}"
                AutomationProperties.Name="{Binding SwitchLabelDpiText}" ToolTip="{loc:T Print.SwitchLabelDpi.Tip}" />
        <Expander Header="{Binding ConversionIssuesHeader}" Margin="0,6,0,0" Visibility="{Binding HasConversionIssues, Converter={StaticResource B2V}}"
                  AutomationProperties.Name="{Binding ConversionIssuesHeader}">
          <ItemsControl ItemsSource="{Binding ConversionIssues}" Margin="16,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" Style="{StaticResource MutedText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
    </Border>
    <!-- ============================== where to print -->
    <TextBlock Text="{loc:T Print.Section.Printer}" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
    <!-- No GroupName on purpose: a named group is shared by every view instance (Print dialog, Data merge, closed windows not yet collected), so the radios of
         different windows uncheck each other and their two-way bindings chase each other until the stack overflows. Radios with the same parent form their own group. -->
    <WrapPanel Margin="0,0,0,8">
      <RadioButton Content="{loc:T Print.Transport.Windows}" IsChecked="{Binding UseWindowsPrinter, Mode=TwoWay}"
                   AutomationProperties.Name="{loc:T Print.Transport.Windows}" />
      <RadioButton Content="{loc:T Print.Transport.Network}" IsChecked="{Binding UseNetwork, Mode=TwoWay}"
                   AutomationProperties.Name="{loc:T Print.Transport.Network}" />
    </WrapPanel>

    <!-- Windows printer -->
    <StackPanel Visibility="{Binding UseWindowsPrinter, Converter={StaticResource B2V}}">
      <TextBlock Text="{loc:T Print.Printer.Label}" Style="{StaticResource FieldLabel}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="{loc:T Print.Printers.Refresh}"
                AutomationProperties.Name="{loc:T Print.Printers.Refresh}" Click="OnRefreshPrinters">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}" />
        </Button>
        <ComboBox ItemsSource="{Binding Printers}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding SelectedPrinterName}"
                  AutomationProperties.Name="{loc:T Print.Printer.Label}" />
      </DockPanel>
      <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" Visibility="{Binding IsLoadingPrinters, Converter={StaticResource B2V}}"
                   AutomationProperties.Name="{loc:T Print.Printers.Loading}" />
      <TextBlock Text="{Binding PrintersNote}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- Network printer -->
    <Grid Visibility="{Binding UseNetwork, Converter={StaticResource B2V}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="110" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{loc:T Print.Host}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Print.Host}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{loc:T Print.Port}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Print.Port}"  ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=int:1:65535}" />
      </StackPanel>
    </Grid>

    <!-- ============================== printer profile -->
    <TextBlock Text="{loc:T Print.Section.Setup}" Style="{StaticResource SectionHeading}" Margin="0,20,0,8" AutomationProperties.HeadingLevel="Level2" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
        <TextBlock Text="{loc:T Print.Profile.Dpi}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding DpiChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedDpi}"
                  AutomationProperties.Name="{loc:T Print.Profile.Dpi}" />
        <!-- Result of reading the driver: a small progress bar while it runs, then a plain-language note. -->
        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" Visibility="{Binding IsDetecting, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Print.Dpi.Detecting}" />
        <TextBlock Text="{Binding DpiNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasDpiNote, Converter={StaticResource B2V}}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
        <TextBlock Text="{loc:T Print.Profile.Media}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding MediaChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedMedia}"
                  AutomationProperties.Name="{loc:T Print.Profile.Media}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
        <TextBlock Text="{loc:T Print.Profile.Width}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Print.Profile.Width}"  ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=double:0.01:100000}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
        <TextBlock Text="{loc:T Print.Profile.Height}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Print.Profile.Height}"  ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=double:0.01:100000}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0">
        <TextBlock Text="{loc:T Print.Profile.Darkness}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding DarknessText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Print.Profile.Darkness}"  ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=int:0:30:opt}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2">
        <TextBlock Text="{loc:T Print.Profile.Speed}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Print.Profile.Speed}"  ctl:FieldState.HasError="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource FieldInvalid}, ConverterParameter=int:1:14:opt}" />
      </StackPanel>
    </Grid>
    <TextBlock Text="{loc:T Print.Profile.Hint}" Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="12" />
    <Button Content="{Binding DetectedSizeText}" Command="{Binding UseDetectedSizeCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource ToolButton}"
            Visibility="{Binding HasDetectedSize, Converter={StaticResource B2V}}" ToolTip="{loc:T Print.UsePrinterSize.Tip}" AutomationProperties.Name="{Binding DetectedSizeText}" />
  </StackPanel>
</UserControl>
