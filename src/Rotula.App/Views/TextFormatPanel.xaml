<UserControl x:Class="Rotula.App.Views.TextFormatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rotula.App.Localization"
             xmlns:vm="clr-namespace:Rotula.App.ViewModels"
             xmlns:ctl="clr-namespace:Rotula.App.Controls">
  <!--
    The formatting block of a selected text in the Properties panel: font, size, bold / italic / underline, alignment, and the warnings that
    belong with them (printed as a picture, font not installed, text does not fit). The data context is the TextFormatViewModel.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Rotula.App;component/Resources/TextFormat.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <Style x:Key="FormatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <!-- Font: printer fonts first, then every installed Windows font, each in its own typeface. Type to search. -->
    <TextBlock Text="{loc:T Prop.Format.Font}" Style="{StaticResource FormatLabel}" />
    <ComboBox x:Name="FontBox" IsEditable="True" ctl:FontSearch.Enabled="True"
              ItemsSource="{Binding FontsView}" SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
              ItemTemplate="{StaticResource FormatFontItem}" TextSearch.TextPath="Display" MaxDropDownHeight="380"
              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
              ToolTip="{loc:T Prop.Format.Font.Tip}"
              AutomationProperties.Name="{loc:T Prop.Format.Font}" AutomationProperties.HelpText="{loc:T Prop.Format.Font.Tip}">
      <ComboBox.GroupStyle>
        <StaticResource ResourceKey="FormatFontGroup" />
      </ComboBox.GroupStyle>
      <ComboBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
      </ComboBox.ItemsPanel>
    </ComboBox>

    <!-- Windows fonts are printed as a picture: a calm one-line reminder, and the first time a fuller explanation the user can dismiss. -->
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{loc:T Panel.Format.Notice.Picture}">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsWindowsFont}" Value="True" />
                <Condition Binding="{Binding ShowRasterNotice}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <Path Style="{StaticResource Icon}" Data="{StaticResource IconImage}" Width="13" Height="13" TextElement.Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Text="{loc:T Panel.Format.Note.Picture}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                 AutomationProperties.HelpText="{loc:T Panel.Format.Notice.Picture}" />
    </StackPanel>
    <Border Style="{StaticResource InfoBanner}" Margin="0,8,0,0" Visibility="{Binding ShowRasterNotice, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel>
        <TextBlock Text="{loc:T Panel.Format.Notice.Picture}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   AutomationProperties.Name="{loc:T Panel.Format.Notice.Picture}" />
        <Button Command="{Binding DismissRasterNoticeCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="12"
                AutomationProperties.Name="{loc:T Panel.Format.Notice.Dismiss}">
          <TextBlock Text="{loc:T Panel.Format.Notice.Dismiss}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Size (points) and the style toggles share a line. -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="104" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{loc:T Prop.Format.Size}" Style="{StaticResource FormatLabel}" />
        <ComboBox x:Name="SizeBox" IsEditable="True" ItemsSource="{x:Static vm:TextFormatViewModel.SizePresets}"
                  Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:T Prop.Format.Size.Tip}"
                  AutomationProperties.Name="{loc:T Prop.Format.Size}" AutomationProperties.HelpText="{loc:T Prop.Format.Size.Tip}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
        <ToggleButton Style="{StaticResource FormatToggle}" IsChecked="{Binding IsBold, Mode=TwoWay}" IsEnabled="{Binding StylesEnabled}" ToolTip="{Binding BoldTip}"
                      AutomationProperties.Name="{loc:T Panel.Format.Bold}" AutomationProperties.HelpText="{Binding BoldTip}" AutomationProperties.AcceleratorKey="Ctrl+B">
          <TextBlock Text="B" FontWeight="Bold" FontSize="16" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource FormatToggle}" IsChecked="{Binding IsItalic, Mode=TwoWay}" IsEnabled="{Binding StylesEnabled}" ToolTip="{Binding ItalicTip}"
                      AutomationProperties.Name="{loc:T Panel.Format.Italic}" AutomationProperties.HelpText="{Binding ItalicTip}" AutomationProperties.AcceleratorKey="Ctrl+I">
          <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="16" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource FormatToggle}" IsChecked="{Binding IsUnderline, Mode=TwoWay}" IsEnabled="{Binding StylesEnabled}" ToolTip="{Binding UnderlineTip}"
                      Margin="0" AutomationProperties.Name="{loc:T Panel.Format.Underline}" AutomationProperties.HelpText="{Binding UnderlineTip}" AutomationProperties.AcceleratorKey="Ctrl+U">
          <TextBlock Text="U" FontSize="16" TextDecorations="Underline" />
        </ToggleButton>
      </StackPanel>
    </Grid>
    <TextBlock Text="{Binding SizeError}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite"
               Visibility="{Binding HasSizeError, Converter={StaticResource BoolToVisibility}}" />

    <!-- Alignment: four segments on one grey track. They need a box (word wrap), so without one they are off and say why. -->
    <Border Background="{StaticResource HoverBrush}" CornerRadius="8" Padding="3" Margin="0,14,0,0" AutomationProperties.Name="{loc:T Prop.Block.Alignment}">
      <UniformGrid Rows="1">
        <ToggleButton Style="{StaticResource FormatSegment}" IsChecked="{Binding AlignLeft, Mode=TwoWay}" IsEnabled="{Binding IsWrap}"
                      ToolTip="{Binding LeftTip}" AutomationProperties.Name="{loc:T Panel.Format.Align.Left}" AutomationProperties.HelpText="{Binding LeftTip}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource FmtIconAlignLeft}" Width="16" Height="16" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource FormatSegment}" IsChecked="{Binding AlignCenter, Mode=TwoWay}" IsEnabled="{Binding IsWrap}"
                      ToolTip="{Binding CenterTip}" AutomationProperties.Name="{loc:T Panel.Format.Align.Center}" AutomationProperties.HelpText="{Binding CenterTip}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource FmtIconAlignCenter}" Width="16" Height="16" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource FormatSegment}" IsChecked="{Binding AlignRight, Mode=TwoWay}" IsEnabled="{Binding IsWrap}"
                      ToolTip="{Binding RightTip}" AutomationProperties.Name="{loc:T Panel.Format.Align.Right}" AutomationProperties.HelpText="{Binding RightTip}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource FmtIconAlignRight}" Width="16" Height="16" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource FormatSegment}" IsChecked="{Binding AlignJustified, Mode=TwoWay}" IsEnabled="{Binding IsWrap}"
                      ToolTip="{Binding JustifiedTip}" AutomationProperties.Name="{loc:T Panel.Format.Align.Justified}" AutomationProperties.HelpText="{Binding JustifiedTip}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource FmtIconAlignJustify}" Width="16" Height="16" />
        </ToggleButton>
      </UniformGrid>
    </Border>

    <!--
      Text fit: what the block does when its text is longer than the box. Only a wrapped block has a box to fit. The computed size is what the
      canvas shows and what is written to the ZPL (and, with data, for each record), so the warning below always speaks about the result.
    -->
    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowFit, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{loc:T Panel.Format.Fit}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level3" />
      <TextBlock Text="{loc:T Panel.Format.Fit.Mode}" Style="{StaticResource FormatLabel}" />
      <ComboBox x:Name="FitModeBox" ItemsSource="{Binding FitModes}" SelectedIndex="{Binding FitModeIndex, Mode=TwoWay}"
                ToolTip="{Binding FitHint}" AutomationProperties.Name="{loc:T Panel.Format.Fit.Mode}" AutomationProperties.HelpText="{Binding FitHint}" />
      <TextBlock Text="{Binding FitHint}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" MaxWidth="280" HorizontalAlignment="Left" />

      <Grid Margin="0,10,0,0" Visibility="{Binding FitIsShrink, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{loc:T Panel.Format.Fit.Min}" Style="{StaticResource FormatLabel}" />
          <TextBox x:Name="FitMinBox" Text="{Binding FitMinText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{loc:T Panel.Format.Fit.Min}" AutomationProperties.HelpText="{Binding FitHint}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="{loc:T Panel.Format.Fit.Max}" Style="{StaticResource FormatLabel}" />
          <TextBox x:Name="FitMaxBox" Text="{Binding FitMaxText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{loc:T Panel.Format.Fit.Max}" AutomationProperties.HelpText="{Binding FitHint}" />
        </StackPanel>
      </Grid>

      <StackPanel Margin="0,10,0,0" Visibility="{Binding FitIsGrow, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{loc:T Panel.Format.Fit.Cap}" Style="{StaticResource FormatLabel}" />
        <TextBox x:Name="FitCapBox" Text="{Binding FitCapText, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="96"
                 AutomationProperties.Name="{loc:T Panel.Format.Fit.Cap}" AutomationProperties.HelpText="{Binding FitHint}" />
      </StackPanel>

      <TextBlock Text="{Binding FitError}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding HasFitError, Converter={StaticResource BoolToVisibility}}" />

      <CheckBox Content="{loc:T Panel.Format.Fit.Ignore}" IsChecked="{Binding FitIgnoreWarning, Mode=TwoWay}" Margin="0,10,0,0"
                ToolTip="{loc:T Panel.Format.Fit.Ignore.Tip}" AutomationProperties.Name="{loc:T Panel.Format.Fit.Ignore}"
                AutomationProperties.HelpText="{loc:T Panel.Format.Fit.Ignore.Tip}" />
    </StackPanel>

    <!-- The font is not installed on this computer: another one is drawn instead. -->
    <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="{Binding HasMissingFont, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel Orientation="Horizontal">
        <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
        <TextBlock Text="{Binding MissingFontText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarningBrush}" MaxWidth="260"
                   AutomationProperties.Name="{Binding MissingFontText}" />
      </StackPanel>
    </Border>

    <!-- The text does not fit its box: say so in plain words and offer the two ways out. -->
    <Border x:Name="OverflowChip" Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <TextBlock Text="{Binding OverflowText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarningBrush}" MaxWidth="260"
                     AutomationProperties.Name="{Binding OverflowText}" />
        </StackPanel>
        <WrapPanel Margin="0,8,0,0">
          <Button Command="{Binding EnlargeBoxCommand}" Style="{StaticResource ToolButton}" Margin="0,0,8,4" Visibility="{Binding CanEnlargeBox, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{loc:T Panel.Format.Fix.Room}">
            <TextBlock Text="{loc:T Panel.Format.Fix.Room}" />
          </Button>
          <Button Command="{Binding ShrinkTextCommand}" Style="{StaticResource ToolButton}" Margin="0,0,0,4" AutomationProperties.Name="{loc:T Panel.Format.Fix.Smaller}">
            <TextBlock Text="{loc:T Panel.Format.Fix.Smaller}" />
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
