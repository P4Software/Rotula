<views:DialogWindow x:Class="Rotula.App.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rotula.App.Views"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- Same visual language as the Print dialog: warm title bar, 24 px margins, outlined secondary buttons and one solid primary button. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
    </Border>
    <Grid Margin="24,24,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Badge" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="0,0,16,0">
        <Path x:Name="BadgeGlyph" Style="{StaticResource Icon}" Width="24" Height="24" StrokeThickness="1.7" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
        <!-- Long lists (problems found, import notes) scroll instead of making the dialog taller than the screen. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,8,0,0" Focusable="False">
          <TextBlock x:Name="Body" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Assertive" />
        </ScrollViewer>
      </StackPanel>
    </Grid>
  </DockPanel>
</views:DialogWindow>
