<UserControl x:Class="Rotula.App.Views.DesignArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rotula.App.Localization"
             xmlns:ctl="clr-namespace:Rotula.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="22" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="28" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,1,1" />
    <ctl:RulerControl x:Name="HRuler" Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                      AutomationProperties.Name="{loc:T Ruler.Horizontal}" />
    <ctl:RulerControl x:Name="VRuler" Grid.Row="1" Grid.Column="0" Orientation="Vertical"
                      AutomationProperties.Name="{loc:T Ruler.Vertical}" />

    <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource WorkspaceDotBrush}" Focusable="False"
                  ScrollChanged="OnScrollChanged" SizeChanged="OnScrollerSizeChanged">
      <ctl:DesignCanvas x:Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                        AutomationProperties.Name="{loc:T Canvas.Name}"
                        AutomationProperties.HelpText="{loc:T Canvas.Help}"
                        ZoomRequested="OnZoomRequested" />
    </ScrollViewer>
  </Grid>
</UserControl>
