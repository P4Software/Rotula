<UserControl x:Class="Rotula.App.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rotula.App.Localization"
             xmlns:vm="clr-namespace:Rotula.App.ViewModels"
             xmlns:ctl="clr-namespace:Rotula.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <DataTemplate DataType="{x:Type vm:HeadingRow}">
      <StackPanel Margin="0,16,0,10">
        <Border Height="1" Background="{StaticResource BorderBrushLight}" Margin="0,0,0,12" />
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:IntRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsUndoEnabled="False"
                 AutomationProperties.Name="{Binding Label}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}">
          <TextBlock.Visibility><Binding Path="HasError" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DoubleRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsUndoEnabled="False"
                 AutomationProperties.Name="{Binding Label}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}">
          <TextBlock.Visibility><Binding Path="HasError" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsUndoEnabled="False"
                 AutomationProperties.Name="{Binding Label}" TextWrapping="Wrap" AcceptsReturn="{Binding IsMultiline}">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                  <Setter Property="MinHeight" Value="64" />
                  <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}">
          <TextBlock.Visibility><Binding Path="HasError" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BoolRow}">
      <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="0,2,0,12" ToolTip="{Binding Hint}"
                AutomationProperties.Name="{Binding Label}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Display"
                  AutomationProperties.Name="{Binding Label}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionRow}">
      <Button Content="{Binding Label}" Command="{Binding RunCommand}" Margin="0,4,0,12" HorizontalAlignment="Left"
              AutomationProperties.Name="{Binding Label}" />
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Background="{StaticResource PanelBrush}">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,16,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionTypeTag}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                 Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" AutomationProperties.Name="{loc:T Panel.TypeTag}" />
      <TextBlock Text="{loc:T Panel.Properties}" Style="{StaticResource PanelHeading}" AutomationProperties.HeadingLevel="Level1" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Properties.Title}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="16,0,16,8" TextTrimming="CharacterEllipsis" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,8" Focusable="False">
      <StackPanel>
        <TextBlock Text="{Binding Properties.Hint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Properties.Rows}" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><ctl:PropertyGridPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Properties.IssueMessages}" Margin="0,12,0,0" IsTabStop="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
