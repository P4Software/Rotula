<UserControl x:Class="Rotula.App.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Rotula.App.Localization"
             xmlns:vm="clr-namespace:Rotula.App.ViewModels"
             xmlns:ctl="clr-namespace:Rotula.App.Controls"
             xmlns:views="clr-namespace:Rotula.App.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The second line of a row (printed size of a QR module, how full a QR code is): muted, or in the warning colour when it is a warning. -->
    <Style x:Key="RowDetail" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding DetailIsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Section heading: hairline above, bold title below. -->
    <DataTemplate DataType="{x:Type vm:HeadingRow}">
      <StackPanel Margin="0,12,0,10">
        <Border Height="1" Background="{StaticResource BorderBrushLight}" Margin="0,0,0,14" />
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" AutomationProperties.HeadingLevel="Level2" />
      </StackPanel>
    </DataTemplate>

    <!-- Number fields: left-aligned monospace text, the unit is part of the label ("Width (dots)"), red border and a plain message when rejected. -->
    <DataTemplate DataType="{x:Type vm:IntRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsUndoEnabled="False"
                 ctl:FieldState.HasError="{Binding HasError}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Hint}" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Detail}">
          <TextBlock.Visibility><Binding Path="HasDetail" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Visibility><Binding Path="HasError" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DoubleRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsUndoEnabled="False"
                 ctl:FieldState.HasError="{Binding HasError}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Hint}" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Visibility><Binding Path="HasError" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <!--
      Text rows. A row that edits an element's content (text, barcode data) also shows the field controls: a "Fixed value | Field" switch,
      the field as a chip with an (x) to go back to a fixed value, an "Insert field" button for text that mixes both, and a quiet warning
      when the field has no column in the loaded data.
    -->
    <DataTemplate DataType="{x:Type vm:TextRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <Grid Margin="0,0,0,4">
          <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <Border HorizontalAlignment="Right" Background="{StaticResource HoverBrush}" CornerRadius="7" Padding="2" Visibility="{Binding IsFieldTarget, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{loc:T Fields.Mode.Tip}" ToolTip="{loc:T Fields.Mode.Tip}">
            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding UnbindCommand}" AutomationProperties.Name="{loc:T Fields.Mode.Fixed}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" MinHeight="26" Padding="10,0">
                      <TextBlock x:Name="Caption" Text="{loc:T Fields.Mode.Fixed}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" /></Trigger>
                      <DataTrigger Binding="{Binding IsFixed}" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                  </Style>
                </Button.Style>
              </Button>
              <views:FieldPickerButton Bind="True" Caption="{loc:T Fields.Mode.Field}" Row="{Binding}" IsActive="{Binding IsBound}" Status="{Binding BoundToken}" />
            </StackPanel>
          </Border>
        </Grid>
        <Grid>
          <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsUndoEnabled="False" ctl:FieldState.HasError="{Binding HasError}" ctl:FieldBox.Row="{Binding}"
                   AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Hint}" TextWrapping="Wrap" AcceptsReturn="{Binding IsMultiline}">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                    <Setter Property="MinHeight" Value="76" />
                    <Setter Property="Padding" Value="12,9" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsBound}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
          <!-- The bound state: the field as a pill; (x) goes back to a fixed value. -->
          <Border CornerRadius="6" MinHeight="40" Padding="12,0,6,0" Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource AccentTintStrongBrush}" BorderThickness="1"
                  ToolTip="{Binding BoundTip}" AutomationProperties.Name="{Binding BoundToken}" AutomationProperties.HelpText="{Binding BoundTip}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsBound}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" VerticalAlignment="Center" Command="{Binding UnbindCommand}"
                      ToolTip="{loc:T Fields.Unbind}" AutomationProperties.Name="{loc:T Fields.Unbind}" AutomationProperties.HelpText="{Binding BoundToken}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" Width="11" Height="11" />
              </Button>
              <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconDataField}" Width="16" Height="16" TextElement.Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding BoundToken}" DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="8,0,10,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding BoundSample}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Right" />
            </DockPanel>
          </Border>
        </Grid>
        <!-- Fixed text: insert fields into it, or find out how to get fields at all. -->
        <WrapPanel Margin="0,8,0,0">
          <WrapPanel.Style>
            <Style TargetType="WrapPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFieldTarget}" Value="True" />
                    <Condition Binding="{Binding IsFixed}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </WrapPanel.Style>
          <views:FieldPickerButton Caption="{loc:T Fields.Insert}" Row="{Binding}" Target="{Binding ElementName=Box}" Margin="0,0,12,0" />
          <Button Style="{StaticResource LinkButton}" Command="{Binding Fields.OpenDataCommand}" Visibility="{Binding Fields.HasNoData, Converter={StaticResource BoolToVisibility}}"
                  VerticalAlignment="Center" FontSize="12" AutomationProperties.Name="{loc:T Fields.OpenData}">
            <TextBlock Text="{loc:T Fields.OpenData}" />
          </Button>
        </WrapPanel>
        <!-- An extra button for rows that have a builder (Content builder, GS1 builder). -->
        <Button Command="{Binding RunActionCommand}" Content="{Binding ActionCaption}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,0" MinHeight="30"
                AutomationProperties.Name="{Binding ActionCaption}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding WarningText}"
                    AutomationProperties.LiveSetting="Polite">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,6,0" />
          <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="290" AutomationProperties.Name="{Binding WarningText}" />
        </StackPanel>
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Visibility><Binding Path="HasError" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BoolRow}">
      <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="0,2,0,12" ToolTip="{Binding Hint}"
                AutomationProperties.Name="{Binding Label}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceRow}">
      <StackPanel ToolTip="{Binding Hint}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" />
        <ComboBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" DisplayMemberPath="Display"
                  AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Hint}">
          <!-- Group headings (barcode families); a list without groups never shows them. -->
          <ComboBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource AccentBrush}" Margin="6,6,0,2" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ComboBox.GroupStyle>
        </ComboBox>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Detail}">
          <TextBlock.Visibility><Binding Path="HasDetail" Converter="{StaticResource BoolToVisibility}" /></TextBlock.Visibility>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <!-- Explanatory note (for example what the preview of a barcode does differently); hidden while empty. -->
    <DataTemplate DataType="{x:Type vm:NoteRow}">
      <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,12" Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Text}" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionRow}">
      <Button Content="{Binding Label}" Command="{Binding RunCommand}" Margin="0,4,0,12" HorizontalAlignment="Left"
              AutomationProperties.Name="{Binding Label}" />
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Background="{StaticResource PanelBrush}">
    <!-- Heading with the kind of the selection as a small tag at the top right. -->
    <DockPanel DockPanel.Dock="Top" Margin="16,14,16,0">
      <Border DockPanel.Dock="Right" Background="{StaticResource AccentTintBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" MaxWidth="150">
        <TextBlock Text="{Binding SelectionTypeTag}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="{loc:T Panel.TypeTag}" />
      </Border>
      <TextBlock Text="{loc:T Panel.Properties}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Properties.Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="16,2,16,10" TextTrimming="CharacterEllipsis"
               ToolTip="{Binding Properties.Subtitle}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,4,8" Focusable="False">
      <StackPanel Margin="0,0,8,0">
        <!-- Empty state: nothing selected, so the panel shows the label's own settings; say so. -->
        <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,4" Visibility="{Binding Properties.ShowsLabel, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{loc:T Panel.LabelHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </Border>
        <TextBlock Text="{Binding Properties.Hint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Properties.Rows}" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><ctl:PropertyGridPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Properties.IssueMessages}" Margin="0,4,0,0" IsTabStop="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,6">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
