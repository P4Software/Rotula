<UserControl x:Class="Rotula.App.Views.DatabaseSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rotula.App.Controls"
             xmlns:loc="clr-namespace:Rotula.App.Localization"
             xmlns:vm="clr-namespace:Rotula.App.ViewModels"
             AutomationProperties.Name="{loc:T Data.Db.Title}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
    <!-- Table and view rows are denser than the 44 px rows of the shared list style: a database can have hundreds of tables. -->
    <Style x:Key="TableRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="4,1" />
      <!-- Without this a screen reader would read the record's ToString() instead of the table name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding QualifiedName}" />
    </Style>
    <Style x:Key="OkText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================== connection + the label's saved reference -->
    <StackPanel Grid.Row="0">
      <Border Style="{StaticResource Card}" Padding="16,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{loc:T Data.Db.Connection}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Connections}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedConnection}"
                        IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:T Data.Db.Connection}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:T Data.Db.NewConnection}" Command="{Binding NewConnectionCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0"
                    AutomationProperties.Name="{loc:T Data.Db.NewConnection}" />
            <Button Grid.Column="2" Content="{loc:T Data.Db.ManageConnections}" Command="{Binding ManageConnectionsCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                    AutomationProperties.Name="{loc:T Data.Db.ManageConnections}" />
          </Grid>
          <TextBlock Text="{loc:T Data.Db.NoConnections}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"
                     Visibility="{Binding HasNoConnections, Converter={StaticResource B2V}}" />
        </StackPanel>
      </Border>

      <!-- The label names a saved connection. Nothing connects until the button is clicked; the query is shown first. -->
      <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="{Binding IsReferencePending, Converter={StaticResource B2V}}">
        <StackPanel>
          <TextBlock Text="{Binding ReferenceBanner}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{loc:T Data.Db.Reference.Safe}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,8" />
          <TextBlock Text="{loc:T Data.Db.Reference.QueryLabel}" Style="{StaticResource FieldLabel}" Foreground="{StaticResource WarningBrush}" />
          <TextBox Text="{Binding ReferenceQuery, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MonoTextBox}" TextWrapping="Wrap" AcceptsReturn="True"
                   MaxHeight="96" Padding="12,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:T Data.Db.Reference.QueryLabel}" />
          <TextBlock Text="{Binding ReferenceMissingText}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Visibility="{Binding ReferenceMissing, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:T Data.Db.Reference.Connect}" Command="{Binding ConnectReferenceCommand}" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="{loc:T Data.Db.Reference.Connect}" />
            <Button Content="{loc:T Data.Db.ManageConnections}" Command="{Binding ManageConnectionsCommand}" Margin="8,0,0,0"
                    Visibility="{Binding ReferenceMissing, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Data.Db.ManageConnections}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ============================== table or query -->
    <TabControl Grid.Row="1" Margin="0,12,0,0" SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="{loc:T Data.Db.Title}">

      <TabItem Header="{loc:T Data.Db.Tab.Table}" AutomationProperties.Name="{loc:T Data.Db.Tab.Table}">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Data.Db.Search}" Style="{StaticResource FieldLabel}" />
            <TextBox DockPanel.Dock="Top" Text="{Binding TableFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="{loc:T Data.Db.Search}" />
            <Border Style="{StaticResource Card}" Padding="0,6">
              <Grid>
                <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" ItemContainerStyle="{StaticResource TableRow}"
                         VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="{loc:T Data.Db.Tables}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{loc:T Data.Db.Kind.View}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="View"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding QualifiedName}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{loc:T Data.Db.NoTablesShown}" Style="{StaticResource MutedText}" Margin="16" VerticalAlignment="Top" TextWrapping="Wrap"
                           Visibility="{Binding ShowNoTables, Converter={StaticResource B2V}}" />
              </Grid>
            </Border>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Data.Db.PreviewHeading}" Style="{StaticResource FieldLabel}" />
            <TextBlock DockPanel.Dock="Bottom" Text="{loc:T Data.Db.PreviewNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
            <Grid>
              <DataGrid x:Name="TableGrid" ItemsSource="{Binding GridRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        AutomationProperties.Name="{loc:T Data.Db.PreviewHeading}" />
              <TextBlock Text="{loc:T Data.Db.PickTable}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Visibility>
                  <Binding Path="HasSelectedTable"><Binding.Converter><ctl:InverseBooleanToVisibilityConverter /></Binding.Converter></Binding>
                </TextBlock.Visibility>
              </TextBlock>
            </Grid>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{loc:T Data.Db.Tab.Query}" AutomationProperties.Name="{loc:T Data.Db.Tab.Query}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{loc:T Data.Db.Query.Label}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="QueryBox" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" MinHeight="92" MaxHeight="140" Padding="12,8" VerticalContentAlignment="Top" SpellCheck.IsEnabled="False"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:T Data.Db.Query.Label}"
                     ToolTip="{loc:T Data.Db.Query.Tip}" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MinHeight="32" VerticalAlignment="Center">
              <DockPanel Visibility="{Binding HasGuardMessage, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource ErrorBrush}" Margin="0,2,6,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding GuardMessage}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Visibility="{Binding GuardOk, Converter={StaticResource B2V}}">
                <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Width="14" Height="14" TextElement.Foreground="{StaticResource SuccessBrush}" Margin="0,2,6,0" VerticalAlignment="Top" />
                <TextBlock Text="{loc:T Data.Db.Guard.Ok}" Style="{StaticResource OkText}" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center" AutomationProperties.Name="{Binding BusyText}" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
              <Button Content="{loc:T Data.Db.Run}" Command="{Binding RunQueryCommand}" MinWidth="96" MinHeight="32" AutomationProperties.Name="{loc:T Data.Db.Run}" ToolTip="{loc:T Data.Db.Run.Tip}" />
              <Button Content="{loc:T Common.StopOperation}" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" MinHeight="32" Margin="8,0,0,0"
                      AutomationProperties.Name="{loc:T Common.StopOperation}" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,8" Margin="0,8,0,0" Visibility="{Binding HasParameters, Converter={StaticResource B2V}}">
            <StackPanel>
              <TextBlock Text="{loc:T Data.Db.Params}" Style="{StaticResource SectionHeading}" Margin="0,0,0,2" ToolTip="{loc:T Data.Db.Params.Hint}" />
              <TextBlock Text="{loc:T Data.Db.Params.Hint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Parameters}" AutomationProperties.Name="{loc:T Data.Db.Params}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName" MinWidth="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:QueryParameterEditor.TypeChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Type}"
                                MinHeight="32" Margin="0,0,8,0" AutomationProperties.Name="{loc:T Data.Db.Param.Type}" />
                      <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" MinHeight="32"
                               AutomationProperties.Name="{Binding Display}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Data.Db.Results}" Style="{StaticResource FieldLabel}" />
            <DataGrid x:Name="ResultGrid" ItemsSource="{Binding GridRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="170"
                      AutomationProperties.Name="{loc:T Data.Db.Results}" />
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- ============================== busy (table mode), errors, row-cap warning -->
    <StackPanel Grid.Row="2" Margin="0,8,0,0">
      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{loc:T Common.StopOperation}" Command="{Binding CancelOperationCommand}" MinHeight="30" Margin="12,0,0,0"
                  AutomationProperties.Name="{loc:T Common.StopOperation}" />
          <StackPanel>
            <TextBlock Text="{Binding BusyText}" Margin="0,0,0,6" />
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{Binding BusyText}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Assertive">
        <StackPanel>
          <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                     Visibility="{Binding HasErrorDetail, Converter={StaticResource B2V}}" AutomationProperties.Name="{loc:T Data.Db.ErrorDetail}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,8" Visibility="{Binding HasInfo, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      </Border>
      <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,8" Visibility="{Binding HasTruncatedWarning, Converter={StaticResource B2V}}" AutomationProperties.LiveSetting="Polite">
        <DockPanel>
          <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconWarning}" Width="14" Height="14" TextElement.Foreground="{StaticResource WarningBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding TruncatedWarning}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
        </DockPanel>
      </Border>
    </StackPanel>

  </Grid>
</UserControl>
