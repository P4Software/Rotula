<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rotula.Core\Rotula.Core.csproj" />
    <ProjectReference Include="..\Rotula.Rendering\Rotula.Rendering.csproj" />
    <ProjectReference Include="..\Rotula.Printing\Rotula.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CommunityToolkit.Mvvm: MIT. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK leaves System.IO and System.Threading.Tasks out of the implicit usings. -->
    <Using Include="System.IO" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <!-- The third-party notices are linked from the repository root (not copied) and embedded, so the About box can show them offline. -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" LogicalName="Rotula.App.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Rotula.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The localized strings live in satellite assemblies (Strings.en / Strings.es); there is no neutral resource. -->
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
