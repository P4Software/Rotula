<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Presets\presets.json" LogicalName="Rotula.Data.Presets.presets.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rotula.Tests" />
    <InternalsVisibleTo Include="Rotula.Data.Packs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rotula.Core\Rotula.Core.csproj" />
    <ProjectReference Include="..\Rotula.Data.Abstractions\Rotula.Data.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Microsoft.Data.SqlClient.SNI.runtime (native SQL Server networking) arrives transitively under Microsoft's
         "Distributable Code" licence terms, not a permissive licence. The owner accepted those terms on
         2026-10-10 (see docs/decisions.md); the notice is listed in THIRD-PARTY-NOTICES.md. -->

    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Not used directly. Microsoft.Data.SqlClient 7.1.1 brings System.Security.Cryptography.Pkcs 9.0.18, which has published
         advisories (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). NuGet audit turns them into build errors here, so
         the patched version is pinned until SqlClient depends on it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
