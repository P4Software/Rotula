<Project>
  <!-- Shared build settings. Core is stricter than the rest: it is the reusable, UI-free library. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>P4 Software</Authors>
    <Company>P4 Software</Company>
    <Product>Rotula</Product>
    <!-- Single source of truth for the release version: build-installer.ps1 reads it, CI overrides it from the tag. -->
    <Version>0.3.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/P4Software/Rotula</RepositoryUrl>
  </PropertyGroup>
</Project>
